{#
/**
 * @file
 * Místo – adresa, poznámka a tlačítko do map (blok club_place).
 * Barvy dědí z okolí (patička i světlá stránka).
 */
#}
<div class="text-sm leading-relaxed">
  {% if address %}<p class="opacity-75">{{ address|nl2br }}</p>{% endif %}
  {% if note %}<p class="{{ address ? 'mt-3' }} opacity-75">{{ note|nl2br }}</p>{% endif %}
  {% if map_url %}
    <a href="{{ map_url }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-md bg-current/10 hover:bg-current/20 font-semibold">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <span>{{ map_label }}</span>
    </a>
  {% endif %}
</div>
