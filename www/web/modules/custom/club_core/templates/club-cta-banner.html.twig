{#
/**
 * @file
 * Výzva – celošířkový pruh s nadpisem, textem a tlačítky (blok club_cta_banner).
 *
 * Proměnné: heading, text, buttons [{label, url, primary}], style
 * (primary | secondary | dark | light).
 */
#}
{% set band = {
  primary: 'bg-red text-white',
  secondary: 'bg-blue text-white',
  dark: 'bg-ink text-bg',
  light: 'bg-surface text-ink border-y border-line',
}[style] %}
{% set main_btn = {
  primary: 'bg-white text-redink hover:bg-white/90',
  secondary: 'bg-white text-blueink hover:bg-white/90',
  dark: 'bg-red text-white hover:bg-redink',
  light: 'bg-red text-white hover:bg-redink',
}[style] %}
{% set other_btn = style == 'light' ? 'border-ink/15 hover:border-ink' : 'border-white/40 hover:bg-white/10' %}
<div class="{{ band }} relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] {{ style == 'light' ? 'bg-card/70 border-x border-red/10' : 'bg-white/10 border-x border-white/15' }} max-md:hidden"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-8 flex flex-wrap items-center justify-between gap-6">
    <div class="max-w-3xl">
      <p class="cond text-3xl sm:text-4xl font-bold leading-none text-balance">{{ heading }}</p>
      {% if text %}<p class="mt-2 opacity-85">{{ text }}</p>{% endif %}
    </div>
    {% if buttons %}
      <div class="flex flex-wrap gap-3">
        {% for b in buttons %}
          <a href="{{ b.url }}" class="px-5 py-3 rounded-md font-semibold {{ b.primary ? main_btn : 'border ' ~ other_btn }}">{{ b.label }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
