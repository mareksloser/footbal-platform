<?php

/**
 * @file
 * Instalace modulu Club Core – založení výchozích týmů.
 */

use Drupal\Core\Config\FileStorage;

/**
 * Implements hook_install().
 */
function club_core_install(bool $is_syncing): void {
  // Při config importu nic nezakládáme, obsah se nesynchronizuje.
  if ($is_syncing) {
    return;
  }
  \Drupal::messenger()->addStatus(_club_core_create_default_teams());
}

/**
 * Založí výchozí týmy (pro už nainstalovaný modul).
 */
function club_core_update_10001(): string {
  return _club_core_create_default_teams();
}

/**
 * Založí typ obsahu Projekt a jeho pole (config/optional).
 *
 * Existující konfigurace (týmy) se přeskočí, pole „Podpořili“ se založí jen
 * když existuje slovník Partneři.
 */
function club_core_update_10002(): string {
  $path = \Drupal::service('extension.list.module')->getPath('club_core') . '/config/optional';
  \Drupal::service('config.installer')->installOptionalConfig(new FileStorage($path));
  return \Drupal::entityTypeManager()->getStorage('node_type')->load('project')
    ? 'Typ obsahu Projekt je připraven. Přidejte mu existující pole Perex (field_lead), Obrázek (field_image) a Text (field_body).'
    : 'Typ obsahu Projekt se nepodařilo založit.';
}

/**
 * Patička z bloků: pole „Zobrazit v pásu partnerů“, menu „Patička – odkazy dole“
 * a výchozí rozmístění bloků v tématu Club.
 */
function club_core_update_10003(): string {
  return _club_core_footer_setup();
}

/**
 * Totéž jako 10003 pro weby, kde 10003 proběhl ještě s první verzí patičky.
 */
function club_core_update_10004(): string {
  return _club_core_footer_setup();
}

/**
 * Založí pole partnera, menu s odkazy a bloky patičky.
 *
 * Existující pole, odkazy a bloky nemění, lze spustit opakovaně.
 */
function _club_core_footer_setup(): string {
  $etm = \Drupal::entityTypeManager();
  $path = \Drupal::service('extension.list.module')->getPath('club_core') . '/config/optional';
  \Drupal::service('config.installer')->installOptionalConfig(new FileStorage($path));
  $messages = [];

  // Pole partnera do formuláře.
  $display = $etm->getStorage('entity_form_display')->load('taxonomy_term.partner.default');
  if ($display && $etm->getStorage('field_config')->load('taxonomy_term.partner.field_partner_footer') && !$display->getComponent('field_partner_footer')) {
    $display->setComponent('field_partner_footer', [
      'type' => 'boolean_checkbox',
      'weight' => 20,
      'settings' => ['display_label' => TRUE],
    ])->save();
    $messages[] = 'Partneři mají pole „Zobrazit v pásu partnerů“.';
  }

  // Odkazy v menu „Patička – odkazy dole“. Stránky GDPR a cookies zatím
  // nemusí existovat – odkazy se proto zakládají vypnuté.
  $links = $etm->getStorage('menu_link_content');
  if ($etm->getStorage('menu')->load('footer-links') && !$links->loadByProperties(['menu_name' => 'footer-links'])) {
    $defaults = [
      ['Ochrana osobních údajů', 'internal:/ochrana-osobnich-udaju', FALSE],
      ['Cookies', 'internal:/cookies', FALSE],
      ['Pro trenéry', 'internal:/user/login', TRUE],
    ];
    foreach ($defaults as $weight => [$title, $uri, $enabled]) {
      $links->create([
        'title' => $title,
        'link' => ['uri' => $uri],
        'menu_name' => 'footer-links',
        'weight' => $weight,
        'enabled' => $enabled,
        'expanded' => FALSE,
      ])->save();
    }
    $messages[] = 'Menu „Patička – odkazy dole“ založeno (GDPR a Cookies jsou vypnuté, zapněte je po vytvoření stránek).';
  }

  // Výchozí bloky v regionech patičky tématu Club.
  if (\Drupal::service('theme_handler')->themeExists('club')) {
    $blocks = $etm->getStorage('block');
    $footer_note = (string) theme_get_setting('footer_note', 'club');
    $placements = [
      'club_partner_strip' => ['club_partner_strip', 'footer_top', 0, ['label' => 'Pás partnerů', 'label_display' => FALSE]],
      'club_place' => ['club_place', 'footer', 10, ['label' => 'Kde hrajeme', 'label_display' => 'visible']],
      'club_copyright' => ['club_copyright', 'footer_bottom', 0, ['label' => 'Copyright', 'label_display' => FALSE, 'note' => $footer_note]],
      'club_footer_links' => ['system_menu_block:footer-links', 'footer_bottom', 10, ['label' => 'Patička – odkazy dole', 'label_display' => FALSE, 'level' => 1, 'depth' => 1]],
    ];
    foreach ($placements as $id => [$plugin, $region, $weight, $settings]) {
      // Přeskočí, pokud už blok s tímto pluginem v tématu je (i ručně umístěný).
      if ($blocks->load($id) || $blocks->loadByProperties(['theme' => 'club', 'plugin' => $plugin])) {
        continue;
      }
      $blocks->create([
        'id' => $id,
        'theme' => 'club',
        'plugin' => $plugin,
        'region' => $region,
        'weight' => $weight,
        'status' => TRUE,
        'settings' => $settings + ['provider' => str_starts_with($plugin, 'system_') ? 'system' : 'club_core'],
        'visibility' => [],
      ])->save();
    }
    $messages[] = 'Bloky patičky rozmístěny (Pás partnerů, Kde hrajeme, Copyright, odkazy dole). Výzvu přidejte do regionu „Patička – pruhy nahoře“.';
  }

  return implode(' ', $messages) ?: 'Patička je už nastavená.';
}

/**
 * Vytvoří chybějící nody typu Tým a nastaví „Celý klub“ jako úvodní stránku.
 *
 * Existující týmy (podle field_slug) přeskočí, lze tedy spustit opakovaně.
 */
function _club_core_create_default_teams(): string {
  $entity_type_manager = \Drupal::entityTypeManager();

  if (!$entity_type_manager->getStorage('node_type')->load('team')) {
    return 'Typ obsahu Tým (team) neexistuje, týmy nebyly vytvořeny.';
  }
  $fields = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', 'team');
  foreach (['field_slug', 'field_short_title', 'field_is_club', 'field_weight'] as $field) {
    if (!isset($fields[$field])) {
      return sprintf('U typu Tým chybí pole %s, týmy nebyly vytvořeny.', $field);
    }
  }

  // [název, krátký název, zkratka, pořadí, celý klub]
  $teams = [
    ['Celý klub', 'Klub', 'klub', 0, TRUE],
    ['Muži A', 'A-tým', 'a-tym', 1, FALSE],
    ['Muži B', 'B-tým', 'b-tym', 2, FALSE],
    ['Dorost U19', 'U19', 'u19', 3, FALSE],
    ['Starší žáci U15', 'U15', 'u15', 4, FALSE],
    ['Mladší žáci U13', 'U13', 'u13', 5, FALSE],
    ['Starší přípravka U11', 'U11', 'u11', 6, FALSE],
    ['Mladší přípravka U9', 'U9', 'u9', 7, FALSE],
  ];

  $storage = $entity_type_manager->getStorage('node');
  $created = 0;
  $club = NULL;

  foreach ($teams as [$title, $short, $slug, $weight, $is_club]) {
    $existing = $storage->loadByProperties(['type' => 'team', 'field_slug' => $slug]);
    $node = $existing ? reset($existing) : NULL;
    if (!$node) {
      $node = $storage->create([
        'type' => 'team',
        'title' => $title,
        'field_short_title' => $short,
        'field_slug' => $slug,
        'field_weight' => $weight,
        'field_is_club' => $is_club,
        'status' => 1,
        'uid' => 1,
      ]);
      $node->save();
      $created++;
    }
    if ($is_club) {
      $club = $node;
    }
  }

  $message = sprintf('Vytvořeno týmů: %d (existující přeskočeny).', $created);

  // Úvodní stránku přepneme jen tehdy, pokud je pořád výchozí.
  if ($club) {
    $config = \Drupal::configFactory()->getEditable('system.site');
    $front = (string) $config->get('page.front');
    if (in_array($front, ['', '/node', '/user/login'], TRUE)) {
      $config->set('page.front', '/node/' . $club->id())->save();
      $message .= sprintf(' Úvodní stránka nastavena na „Celý klub“ (/node/%d).', $club->id());
    }
    else {
      $message .= sprintf(' Úvodní stránka zůstala %s, „Celý klub“ je /node/%d.', $front, $club->id());
    }
  }

  return $message;
}
