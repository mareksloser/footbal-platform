<?php

/**
 * @file
 * Hooky modulu Club Core – jádro klubového webu Footbal Platform.
 */

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function club_core_theme(): array {
  return [
    'club_team_switcher' => [
      'variables' => ['items' => []],
    ],
    'club_contacts' => [
      'variables' => ['sections' => [], 'teams' => []],
    ],
    'club_calendar_subscribe' => [
      'variables' => ['ics_url' => NULL, 'webcal_url' => NULL, 'google_url' => NULL, 'team_label' => NULL],
    ],
  ];
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 *
 * Zkratka týmu (field_slug) musí být unikátní a jen [a-z0-9-],
 * protože se používá v URL (/tym/u15, ?tym=u15).
 */
function club_core_entity_bundle_field_info_alter(array &$fields, EntityTypeInterface $entity_type, string $bundle): void {
  if ($entity_type->id() === 'node' && $bundle === 'team' && isset($fields['field_slug'])) {
    $fields['field_slug']->addConstraint('UniqueField');
    $fields['field_slug']->addPropertyConstraints('value', [
      'Regex' => [
        'pattern' => '/^[a-z0-9-]+$/',
        'message' => 'Zkratka smí obsahovat jen malá písmena bez diakritiky, číslice a pomlčky.',
      ],
    ]);
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Soupiska seřazená podle postu (brankáři → útočníci) a pak čísla.
 * Řadí se v PHP podle pořadí povolených hodnot pole field_position,
 * takže nezáleží na abecedě strojových hodnot ani na databázi.
 * Platí pro všechny displaye view „players“.
 */
function club_core_views_pre_render(ViewExecutable $view): void {
  if ($view->id() !== 'players' || !$view->result) {
    return;
  }
  $first = reset($view->result)->_entity ?? NULL;
  if (!$first || !$first->hasField('field_position')) {
    return;
  }
  $allowed = $first->get('field_position')->getFieldDefinition()->getFieldStorageDefinition()->getSetting('allowed_values') ?? [];
  $order = array_flip(array_keys($allowed));

  $key = static function ($row) use ($order): array {
    $entity = $row->_entity;
    $position = $entity->get('field_position')->value;
    $number = $entity->hasField('field_number') ? $entity->get('field_number')->value : NULL;
    return [$order[$position] ?? 99, $number === NULL ? 999 : (int) $number];
  };
  usort($view->result, static fn($a, $b) => $key($a) <=> $key($b));
  foreach ($view->result as $index => $row) {
    $row->index = $index;
  }
}

/**
 * Implements hook_token_info().
 *
 * [node:club-team] – zkratka týmu (u15, a-tym). U nodu typu Tým jeho vlastní
 * zkratka, u ostatního obsahu zkratka prvního týmu z field_team.
 */
function club_core_token_info(): array {
  return [
    'tokens' => [
      'node' => [
        'club-team' => [
          'name' => t('Zkratka týmu'),
          'description' => t('Zkratka týmu z pole Zkratka v URL (např. u15). U obsahu bere první tým z pole Tým.'),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function club_core_tokens(string $type, array $tokens, array $data, array $options, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata): array {
  $replacements = [];
  if ($type !== 'node' || empty($data['node']) || !isset($tokens['club-team'])) {
    return $replacements;
  }
  /** @var \Drupal\node\NodeInterface $node */
  $node = $data['node'];
  $team = NULL;
  if ($node->bundle() === 'team') {
    $team = $node;
  }
  elseif ($node->hasField('field_team') && !$node->get('field_team')->isEmpty()) {
    $team = $node->get('field_team')->entity;
  }
  if ($team && $team->hasField('field_slug') && !$team->get('field_slug')->isEmpty()) {
    $replacements[$tokens['club-team']] = $team->get('field_slug')->value;
    $bubbleable_metadata->addCacheableDependency($team);
  }
  return $replacements;
}

/**
 * Implements hook_block_build_alter().
 *
 * Menu v hlavičce ukazuje štítek společného týmu (téma Club), takže se musí
 * přegenerovat při změně týmu.
 */
function club_core_block_build_alter(array &$build, \Drupal\Core\Block\BlockPluginInterface $block): void {
  if (in_array($block->getBaseId(), ['system_menu_block', 'menu_block'], TRUE)) {
    $build['#cache']['tags'][] = 'node_list:team';
  }
}
