{# Kompaktní kontakty vedení do bočního panelu. #}
<div{{ attributes.addClass('club-card') }}>
  <h2 class="cond text-2xl font-bold mb-2">{{ club.title }}</h2>
  {% if not club.items %}
    <p class="text-sm text-muted py-2">Zatím tu nikdo není. Kontakty se berou z realizačního týmu nodu „Celý klub“.</p>
  {% endif %}
  <ul class="divide-y divide-line text-sm">
    {% for c in club.items %}
      <li class="py-3">
        <p class="text-muted">{{ c.role }}</p>
        <p class="font-semibold">{{ c.name }}</p>
        {% if c.email %}<a href="mailto:{{ c.email }}" class="block text-redink hover:underline truncate">{{ c.email }}</a>{% endif %}
        {% if c.phone %}<a href="tel:{{ c.phone_href }}" class="block text-redink hover:underline tnum">{{ c.phone }}</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
  {% if club.contacts_url %}<a href="{{ club.contacts_url }}" class="inline-block mt-3 text-sm font-semibold text-redink hover:underline">Všechny kontakty</a>{% endif %}
</div>
