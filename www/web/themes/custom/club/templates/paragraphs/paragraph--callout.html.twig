{# Zvýrazněný blok (např. spolupráce s partnerským klubem). Barva podle field_style. #}
{% set tone = {
  'blue': ['bg-blue text-white', 'text-blue'],
  'red': ['bg-red text-white', 'text-red'],
  'ink': ['bg-ink text-bg', 'text-ink'],
}[club.style] ?? ['bg-blue text-white', 'text-blue'] %}
<section{{ attributes.addClass(tone[0], 'rounded-xl', 'p-6', 'sm:p-8', 'flex', 'gap-6', 'items-start') }}>
  {% if club.badge %}
    <span class="shrink-0 grid place-items-center h-16 w-[3.25rem] shield bg-white"><span class="cond font-extrabold {{ tone[1] }}">{{ club.badge }}</span></span>
  {% endif %}
  <div class="min-w-0">
    {% if club.title %}<h2 class="cond text-3xl font-bold">{{ club.title }}</h2>{% endif %}
    <div class="mt-2 leading-relaxed max-w-prose opacity-90 [&_a]:underline [&_p+p]:mt-3">{{ content.field_text }}</div>
    {% if club.links %}
      <div class="mt-4 flex flex-wrap gap-2">
        {% for l in club.links %}
          <a href="{{ l.url }}" class="h-9 px-3.5 inline-flex items-center rounded-md bg-white {{ tone[1] }} text-sm font-semibold hover:opacity-90">{{ l.title }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
