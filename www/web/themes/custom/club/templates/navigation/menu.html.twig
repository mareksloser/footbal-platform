{#
/**
 * @file
 * Ostatní menu (patička apod.) – jednoduchý seznam; ve spodní liště patičky vodorovně.
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 and attributes.hasAttribute('data-club-region') and (attributes['data-club-region'] ~ '') == 'footer-bottom' %}
      <ul{{ attributes.removeAttribute('data-club-region').addClass('flex', 'flex-wrap', 'gap-x-5', 'gap-y-2') }}>
    {% elseif menu_level == 0 %}
      <ul{{ attributes.addClass('space-y-1.5') }}>
    {% else %}
      <ul class="mt-1.5 ml-3 space-y-1.5">
    {% endif %}
      {% for item in items %}
        <li>
          {{ link(item.title, item.url, {'class': ['hover:underline', 'underline-offset-4']}) }}
          {% if item.below %}{{ menus.menu_links(item.below, attributes, menu_level + 1) }}{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
