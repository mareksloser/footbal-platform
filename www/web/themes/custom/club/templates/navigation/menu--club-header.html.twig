{#
/**
 * @file
 * Menu v hlavičce (regiony header_left/header_right) s rozbalovacími podmenu.
 * Na desktopu se podmenu otevírá najetím nebo klávesnicí, v mobilním menu
 * tlačítkem (viz club.js a třídy .club-nav / .club-mobile-nav v CSS).
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{#
  Aktivní položka (club_active ze club_preprocess_menu):
  - hlavní úroveň: linka v hlavní barvě pod textem (bez tučného písma – neposouvá menu),
  - podmenu: šedé podbarvení + svislá linka vlevo.
#}
{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% set bar = 'club-nav__active text-ink relative after:absolute after:inset-x-3 after:bottom-0.5 after:h-0.5 after:rounded-full after:bg-red' %}
  {% set sub = 'club-nav__active bg-surface font-semibold text-ink relative before:absolute before:left-0 before:inset-y-2 before:w-0.5 before:rounded-full before:bg-red' %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.removeAttribute('data-club-region').addClass('club-nav', 'flex', 'items-center', 'gap-1', 'text-[15px]') }}>
    {% else %}
      <ul class="club-nav__sub bg-card border border-line rounded-lg shadow-xl p-2 text-sm min-w-60">
    {% endif %}
    {% for item in items %}
      {% if menu_level == 0 and item.below %}
        <li class="club-nav__item relative group">
          <button type="button" class="club-nav__toggle w-full px-3 py-2 rounded-md hover:bg-surface flex items-center justify-between gap-1 {{ item.club_active ? bar }}" aria-expanded="false">
            {{ item.title }}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="club-dd absolute left-0 top-full pt-2 z-50">
            {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
          </div>
        </li>
      {% elseif menu_level == 0 %}
        <li class="club-nav__item">
          <a href="{{ item.url }}" class="block px-3 py-2 rounded-md hover:bg-surface {{ item.club_active ? bar }}"{% if item.club_active == 'page' %} aria-current="page"{% endif %}>{{ item.title }}</a>
        </li>
      {% elseif item.url.routed and item.url.routeName == '<nolink>' %}
        {# Položka s odkazem <nolink> v podmenu = nadpis skupiny (Dospělí, Mládež). #}
        <li class="px-3 pt-3 pb-1 text-xs text-muted first:pt-1">{{ item.title }}</li>
      {% else %}
        <li>
          <a href="{{ item.url }}" class="flex items-center justify-between gap-3 px-3 py-2 rounded hover:bg-surface {{ item.club_active ? sub }}"{% if item.club_active == 'page' %} aria-current="page"{% endif %}>
            <span>{{ item.title }}</span>
            {% if item.club_merged %}<span class="text-xs text-blueink whitespace-nowrap">{{ item.club_merged }}</span>{% endif %}
          </a>
        </li>
      {% endif %}
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
