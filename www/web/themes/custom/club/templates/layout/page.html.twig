{#
/**
 * @file
 * Stránka – lišta akcí, hlavička s logem uprostřed, přepínač týmů, obsah, patička.
 *
 * Proměnné z club_preprocess_page():
 * - logo_url, site_name, cta_label, cta_label_mobile, cta_url,
 *   club_name, club_address, club_email, footer_note, is_team_page, year,
 *   footer (nábor, partneři, kontakt, týmy, areál – _club_footer()).
 */
#}
<div class="min-h-screen flex flex-col">

  {% if page.ticker %}
    <div class="bg-red text-white" data-club-ticker>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 h-10 flex items-center gap-3 text-sm">
        <span class="font-semibold shrink-0 max-sm:hidden">Nejbližší akce</span>
        <span class="h-4 w-px bg-white/40 max-sm:hidden" aria-hidden="true"></span>
        <div class="flex-1 min-w-0 club-ticker" aria-live="polite">{{ page.ticker }}</div>
        <div class="flex items-center gap-1 shrink-0" data-ticker-controls hidden>
          <button type="button" data-ticker-prev class="h-7 w-7 grid place-items-center rounded hover:bg-white/15" aria-label="Předchozí akce">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span data-ticker-count class="tnum text-xs text-white/80 w-9 text-center"></span>
          <button type="button" data-ticker-next class="h-7 w-7 grid place-items-center rounded hover:bg-white/15" aria-label="Další akce">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  {% endif %}

  <header class="sticky top-[var(--drupal-displace-offset-top,0px)] z-50 bg-bg/95 backdrop-blur border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 h-20 grid grid-cols-[1fr_auto_1fr] items-center">
      <div class="flex max-lg:hidden items-center min-w-0">{{ page.header_left }}</div>

      <button type="button" class="lg:hidden justify-self-start h-10 w-10 grid place-items-center rounded-md hover:bg-surface"
              data-club-menu-toggle aria-controls="club-mobile-menu" aria-expanded="false" aria-label="Otevřít menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <a href="{{ path('<front>') }}" class="justify-self-center flex items-center" rel="home" aria-label="{{ site_name }} – úvod">
        <img src="{{ logo_url }}" alt="Znak {{ site_name }}" class="h-16 w-auto" width="240" height="288">
      </a>

      <div class="flex max-lg:hidden items-center justify-end gap-1 min-w-0">
        {{ page.header_right }}
        {% if cta_url and cta_label %}
          <a href="{{ cta_url }}" class="ml-2 px-4 py-2 rounded-md bg-ink text-bg font-semibold hover:opacity-90 whitespace-nowrap">{{ cta_label }}</a>
        {% endif %}
      </div>
      {% if cta_url and cta_label_mobile %}
        <a href="{{ cta_url }}" class="lg:hidden justify-self-end text-sm font-semibold px-3 py-2 rounded-md bg-ink text-bg">{{ cta_label_mobile }}</a>
      {% else %}
        <span class="lg:hidden"></span>
      {% endif %}
    </div>

    <div id="club-mobile-menu" class="club-mobile-nav lg:hidden hidden border-t border-line bg-bg max-h-[70vh] overflow-y-auto">
      <div class="px-4 py-3 text-[15px]">
        {{ page.header_left }}
        {{ page.header_right }}
      </div>
    </div>

    {% if page.switcher %}
      <div class="border-t border-line bg-bg">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center gap-3 h-14">
          <span class="text-sm text-muted shrink-0 max-md:hidden">Zobrazit obsah pro</span>
          <div class="min-w-0 flex-1 club-fade-x">{{ page.switcher }}</div>
        </div>
      </div>
    {% endif %}
  </header>

  {% if page.highlighted %}
    <div class="mx-auto max-w-7xl w-full px-4 sm:px-6 pt-6">{{ page.highlighted }}</div>
  {% endif %}

  {% if page.page_header and not hide_page_header %}
    <div class="bg-surface border-b border-line relative overflow-hidden">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-red"></div>
      <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12 space-y-5">{{ page.page_header }}</div>
    </div>
  {% endif %}

  <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
    {{ page.content }}
  </main>

  {% set f = footer %}
  <footer class="mt-16">
    {# Náborový pruh #}
    {% if f.recruit %}
      <div class="bg-red text-white relative overflow-hidden">
        <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-white/10 border-x border-white/15 max-md:hidden"></div>
        <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-8 flex flex-wrap items-center justify-between gap-6">
          <div>
            {% if f.recruit.title %}<p class="cond text-3xl sm:text-4xl font-bold leading-none">{{ f.recruit.title }}</p>{% endif %}
            {% if f.recruit.text %}<p class="mt-2 text-white/85">{{ f.recruit.text }}</p>{% endif %}
          </div>
          <div class="flex flex-wrap gap-3">
            {% if f.recruit.url and f.recruit.label %}
              <a href="{{ f.recruit.url }}" class="px-5 py-3 rounded-md bg-white text-redink font-semibold hover:bg-white/90">{{ f.recruit.label }}</a>
            {% endif %}
            {% if f.recruit.second_url and f.recruit.second_label %}
              <a href="{{ f.recruit.second_url }}" class="px-5 py-3 rounded-md border border-white/40 font-semibold hover:bg-white/10">{{ f.recruit.second_label }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

    <div class="bg-ink text-bg">
      {# Partneři #}
      {% if f.partners %}
        <div class="border-b border-bg/10">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 py-6 flex flex-wrap items-center gap-x-8 gap-y-4">
            <span class="text-xs uppercase tracking-wider text-bg/50 font-semibold">Podporují nás</span>
            <ul class="flex flex-wrap items-center gap-3">
              {% for p in f.partners %}
                <li>
                  {% set tag = p.url ? 'a' : 'span' %}
                  <{{ tag }}{% if p.url %} href="{{ p.url }}" target="_blank" rel="noopener"{% endif %} class="h-12 px-3 grid place-items-center rounded-md {{ p.logo_url ? 'bg-white opacity-80 hover:opacity-100' : 'text-bg/60 hover:text-bg font-semibold cond text-lg' }}" title="{{ p.name }}">
                    {% if p.logo_url %}<img src="{{ p.logo_url }}" alt="{{ p.name }}" loading="lazy" class="h-8 w-auto max-w-28 object-contain">{% else %}{{ p.name }}{% endif %}
                  </{{ tag }}>
                </li>
              {% endfor %}
            </ul>
            {% if f.partner_cta_url %}
              <a href="{{ f.partner_cta_url }}" class="ml-auto text-sm text-bg/60 hover:text-bg">Staňte se partnerem →</a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {# Hlavní část #}
      <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
        <div>
          <div class="flex items-center gap-4">
            <img src="{{ logo_url }}" alt="" class="h-16 w-auto">
            {% if club_name %}<p class="cond text-2xl font-bold leading-tight text-balance">{{ club_name }}</p>{% endif %}
          </div>
          {% if club_address or f.ico %}
            <p class="mt-5 text-sm text-bg/70 leading-relaxed">
              {% if club_address %}{{ club_address|nl2br }}{% endif %}
              {% if f.ico %}{% if club_address %}<br>{% endif %}IČO {{ f.ico }}{% endif %}
            </p>
          {% endif %}
          {% if club_email or f.phone %}
            <p class="mt-3 text-sm space-y-1">
              {% if club_email %}<a href="mailto:{{ club_email }}" class="block text-bg/70 hover:text-bg">{{ club_email }}</a>{% endif %}
              {% if f.phone %}<a href="{{ f.phone_href }}" class="block text-bg/70 hover:text-bg tnum">{{ f.phone }}</a>{% endif %}
            </p>
          {% endif %}
          {% if f.socials %}
            <ul class="mt-5 flex gap-2">
              {% for s in f.socials %}
                <li>
                  <a href="{{ s.url }}" target="_blank" rel="noopener" aria-label="{{ s.label }}" class="h-10 w-10 grid place-items-center rounded-full bg-bg/10 hover:bg-red hover:text-white">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {% if s.key == 'instagram' %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/>
                      {% elseif s.key == 'facebook' %}<path d="M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2z"/>
                      {% else %}<rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9l5 3-5 3z" fill="currentColor"/>{% endif %}
                    </svg>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        {% if f.team_groups %}
          <nav aria-labelledby="footer-teams">
            <h2 id="footer-teams" class="cond text-xl font-bold mb-3">Týmy</h2>
            {% for group in f.team_groups %}
              {% if group.label %}<p class="text-xs uppercase tracking-wider text-bg/50 font-semibold mb-1">{{ group.label }}</p>{% endif %}
              <ul class="text-sm grid {{ group.teams|length > 3 ? 'grid-cols-2' }} gap-x-4 gap-y-1.5 {{ not loop.last ? 'mb-4' }}">
                {% for team in group.teams %}<li><a href="{{ team.url }}" class="text-bg/70 hover:text-bg">{{ team.label }}</a></li>{% endfor %}
              </ul>
            {% endfor %}
          </nav>
        {% endif %}

        {% if page.footer %}
          <div class="club-footer space-y-8">{{ page.footer }}</div>
        {% endif %}

        {% if f.venue_address or f.training_note %}
          <div>
            <h2 class="cond text-xl font-bold mb-3">Kde hrajeme</h2>
            {% if f.venue_address %}<p class="text-sm text-bg/70 leading-relaxed">{{ f.venue_address|nl2br }}</p>{% endif %}
            {% if f.training_note %}<p class="mt-3 text-sm text-bg/70 leading-relaxed">{{ f.training_note|nl2br }}</p>{% endif %}
            {% if f.venue_map_url %}
              <a href="{{ f.venue_map_url }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-md bg-bg/10 hover:bg-bg/20 text-sm font-semibold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                Navigovat
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {# Spodní lišta #}
      <div class="border-t border-bg/10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-bg/50">
          <p>© {{ year }} {{ site_name }}.{% if footer_note %} {{ footer_note }}{% endif %}</p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2 sm:ml-auto">
            {% if f.privacy_url %}<li><a href="{{ f.privacy_url }}" class="hover:text-bg">Ochrana osobních údajů</a></li>{% endif %}
            {% if f.cookies_url %}<li><a href="{{ f.cookies_url }}" class="hover:text-bg">Cookies</a></li>{% endif %}
            <li><a href="{{ f.login_url }}" class="hover:text-bg" rel="nofollow">Pro trenéry</a></li>
            <li><a href="#main-content" class="hover:text-bg">Nahoru ↑</a></li>
          </ul>
        </div>
      </div>
    </div>
  </footer>
</div>
