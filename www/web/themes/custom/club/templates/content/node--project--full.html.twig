{#
/**
 * @file
 * Detail projektu – stav, termín, popis, karta „O projektu“, partneři, další projekty.
 * Data: club (karta) a project (detail) ze club_preprocess_node__project().
 */
#}
<article{{ attributes }}>
  {{ title_prefix }}{{ title_suffix }}

  {# --- Záhlaví --- #}
  <header class="bg-surface border-b border-line relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-red"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12">
      <nav aria-label="Drobečková navigace" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="{{ path('<front>') }}" class="hover:text-ink">Úvod</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a href="/projekty" class="hover:text-ink">Projekty</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">{{ label }}</span></li>
        </ol>
      </nav>
      <div class="mt-6 max-w-4xl">
        <p class="mb-3 flex flex-wrap items-center gap-3 text-sm text-muted">
          {{ include('club:project-status', {status: club.status, label: club.status_label}, with_context = false) }}
          {% if club.term %}<span>{{ club.term }}</span>{% endif %}
        </p>
        <h1 class="cond text-4xl sm:text-6xl font-bold leading-[.95] text-balance">{{ label }}</h1>
        {% if club.lead %}<p class="mt-3 text-lg text-muted max-w-2xl">{{ club.lead }}</p>{% endif %}
      </div>
    </div>
  </header>

  {# --- Obsah --- #}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid lg:grid-cols-[1fr_22rem] gap-12">
    <div class="min-w-0 space-y-12">
      {% if project.image %}
        <img src="{{ project.image }}" alt="{{ project.image_alt }}" class="w-full aspect-[16/9] object-cover rounded-xl">
      {% endif %}
      {% if content.body|render|striptags|trim %}
        <div class="club-prose max-w-3xl">{{ content.body }}</div>
      {% endif %}
    </div>

    <aside class="space-y-6 lg:sticky lg:top-44 self-start">
      <div class="club-card">
        <h2 class="cond text-2xl font-bold mb-3">O projektu</h2>
        <dl class="text-sm divide-y divide-line">
          <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Stav</dt><dd class="text-right font-semibold">{{ club.status_label }}</dd></div>
          {% if club.term %}
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Termín</dt><dd class="text-right font-semibold">{{ club.term }}</dd></div>
          {% endif %}
          {% if project.budget %}
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Rozpočet</dt><dd class="text-right font-semibold tnum">{{ project.budget }}</dd></div>
          {% endif %}
          {% if project.funding %}
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Financování</dt><dd class="text-right font-semibold">{{ project.funding }}</dd></div>
          {% endif %}
        </dl>
        {% if club.progress is not null and club.status == 'running' %}
          <div class="mt-4">
            <div class="flex justify-between text-sm mb-1.5"><span class="text-muted">Hotovo</span><span class="font-semibold tnum">{{ club.progress }} %</span></div>
            <div class="h-2 rounded-full bg-line overflow-hidden" role="progressbar" aria-valuenow="{{ club.progress }}" aria-valuemin="0" aria-valuemax="100" aria-label="Postup projektu">
              <div class="h-full rounded-full bg-red" style="width: {{ club.progress }}%"></div>
            </div>
          </div>
        {% endif %}
      </div>

      {% if project.partners %}
        <div>
          <h2 class="cond text-2xl font-bold mb-3">Podpořili</h2>
          <div class="grid grid-cols-2 gap-3">{{ project.partners }}</div>
        </div>
      {% endif %}
    </aside>
  </div>

  {% if project.related %}
    <section class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="py-12 border-t border-line">
        <div class="flex items-end justify-between gap-4 mb-6">
          <h2 class="cond text-3xl font-bold">Další projekty</h2>
          <a href="/projekty" class="text-sm font-semibold text-redink hover:underline">Všechny projekty</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">{{ project.related }}</div>
      </div>
    </section>
  {% endif %}
</article>
