{% if title %}
  {{ title_prefix }}
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <h1{{ title_attributes.addClass('cond', 'text-5xl', 'sm:text-6xl', 'font-bold', 'leading-[.95]') }}>{{ title }}</h1>
      {% if subtitle %}<p class="text-muted mt-3 max-w-2xl text-lg">{{ subtitle }}</p>{% endif %}
      {% if meta_date or meta_teams %}
        <p class="mt-4 flex flex-wrap items-center gap-2 text-sm text-muted">
          {% for t in meta_teams %}{{ include('club:team-chip', {label: t.label, merged: t.merged, club: t.club}, with_context = false) }}{% endfor %}
          {% if meta_date %}<span>{{ meta_date|capitalize }}</span>{% endif %}
        </p>
      {% endif %}
    </div>
    {% if team_merged %}
      <div class="flex items-center gap-3 bg-blue/10 text-blueink rounded-lg px-4 py-3 text-sm font-semibold">
        <span class="grid place-items-center h-9 w-7 shield bg-blue"><span class="cond text-white text-[10px] font-extrabold">{{ partner_name|slice(0, 3)|upper }}</span></span>
        Společný tým s {{ partner_name }}
      </div>
    {% endif %}
  </div>
  {{ title_suffix }}
{% endif %}
