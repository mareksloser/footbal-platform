{#
/**
 * @file
 * Detail zápasu – vlastní záhlaví se skóre, průběh, sestava, videa, report.
 * Data: club (skóre, týmy, datum…) a match (detail) ze club_preprocess_node__match().
 */
#}
{% set played = club.played %}
<article{{ attributes }}>
  {{ title_prefix }}{{ title_suffix }}

  {# --- Záhlaví --- #}
  <header class="bg-surface border-b border-line relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 {{ club.team_merged ? 'bg-blue' : 'bg-red' }}"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12">
      <nav aria-label="Drobečková navigace" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="{{ path('<front>') }}" class="hover:text-ink">Úvod</a></li>
          {% if match.team_name %}
            <li class="flex items-center gap-2"><span aria-hidden="true">/</span>
              {% if match.team_url %}<a href="{{ match.team_url }}" class="hover:text-ink">{{ match.team_name }}</a>{% else %}{{ match.team_name }}{% endif %}
            </li>
          {% endif %}
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">Detail zápasu</span></li>
        </ol>
      </nav>

      <div class="mt-5 flex flex-wrap items-end justify-between gap-6">
        <div class="min-w-0">
          {% if match.status_label %}
            <span class="inline-block mb-3 px-2.5 py-1 rounded-full bg-ink text-bg text-sm font-bold">{{ match.status_label }}</span>
          {% endif %}
          <h1 class="cond text-4xl sm:text-6xl font-bold leading-[.95] text-balance">
            <span class="sm:inline block">{{ club.home_name }}</span>
            <span class="tnum whitespace-nowrap {{ played ? 'text-redink' : 'text-muted' }}">
              {% if played %}{{ club.home_score }}:{{ club.away_score }}{% else %}–{% endif %}
            </span>
            <span class="sm:inline block">{{ club.away_name }}</span>
          </h1>
          <p class="text-muted mt-3 max-w-2xl text-lg">
            {{ club.date.long|capitalize }}{{ club.date.time ? ', ' ~ club.date.time }}.
            {% if club.competition %}{{ club.competition }}.{% endif %}
            {% if club.venue %}{{ club.venue }}.{% endif %}
          </p>
        </div>
        {% if club.team_merged %}
          <div class="flex items-center gap-3 bg-blue/10 text-blueink rounded-lg px-4 py-3 text-sm font-semibold">
            <span class="grid place-items-center h-9 w-7 shield bg-blue"><span class="cond text-white text-[10px] font-extrabold">{{ club.partner_short }}</span></span>
            Společný tým
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {# --- Obsah --- #}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid lg:grid-cols-[1fr_22rem] gap-12">
    <div class="min-w-0 space-y-12">

      {% if match.events %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">Průběh zápasu</h2>
          <ol class="relative border-l-2 border-line ml-12">
            {% for e in match.events %}
              <li class="relative pl-8 py-3 flex items-center gap-3 {{ e.ours ? '' : 'text-muted' }}">
                <span class="absolute -left-12 w-9 text-right cond text-xl font-bold tnum {{ e.ours ? 'text-redink' }}">{{ e.minute }}′</span>
                <span class="absolute -left-[11px] grid place-items-center h-5 w-5 rounded-full bg-bg">
                  {% if e.goal %}
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" class="{{ e.ours ? 'text-redink' : 'text-muted' }}"><circle cx="12" cy="12" r="10" fill="rgb(var(--club-card))" stroke="currentColor" stroke-width="2"/><path d="M12 7l4 3-1.5 4.5h-5L8 10z" fill="currentColor"/></svg>
                  {% elseif e.card == 'red' %}
                    <span class="block h-4 w-3 rounded-[2px] bg-red"></span>
                  {% elseif e.card == 'second_yellow' %}
                    <span class="relative block h-4 w-3"><span class="absolute inset-0 rounded-[2px] bg-[#f2c500] -translate-x-0.5 -translate-y-0.5"></span><span class="absolute inset-0 rounded-[2px] bg-red translate-x-0.5 translate-y-0.5"></span></span>
                  {% else %}
                    <span class="block h-4 w-3 rounded-[2px] bg-[#f2c500]"></span>
                  {% endif %}
                </span>
                <span class="min-w-0 {{ e.goal and e.ours ? 'font-semibold' }}">
                  {{ e.label }}{% if e.player %}: {% if e.player_url %}<a href="{{ e.player_url }}" class="hover:text-redink">{{ e.player }}</a>{% else %}{{ e.player }}{% endif %}{% endif %}
                  {% if e.assist %}<span class="text-muted font-normal text-sm">, asistence {% if e.assist_url %}<a href="{{ e.assist_url }}" class="hover:text-redink">{{ e.assist }}</a>{% else %}{{ e.assist }}{% endif %}</span>{% endif %}
                </span>
                {% if e.score %}<span class="cond text-xl font-bold tnum ml-auto">{{ e.score }}</span>{% endif %}
              </li>
            {% endfor %}
          </ol>
        </section>
      {% elseif not played %}
        <section class="border border-dashed border-line rounded-xl p-8 text-center">
          <p class="font-semibold">Zápas se teprve odehraje.</p>
          <p class="text-muted mt-1">{{ club.date.long|capitalize }}{{ club.date.time ? ' v ' ~ club.date.time }}{{ club.venue ? ', ' ~ club.venue }}.</p>
        </section>
      {% endif %}

      {% if match.quote %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">Slovo trenéra</h2>
          <blockquote class="border-l-4 {{ club.team_merged ? 'border-blue' : 'border-red' }} pl-6">
            <p class="text-xl leading-relaxed">„{{ match.quote }}“</p>
            {% if match.coach %}<footer class="mt-3 text-muted">{{ match.coach }}, trenér</footer>{% endif %}
          </blockquote>
        </section>
      {% endif %}

      {% if content.body|render|trim %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">Report ze zápasu</h2>
          <div class="club-prose max-w-3xl">{{ content.body }}</div>
        </section>
      {% endif %}
    </div>

    <aside class="space-y-6 lg:sticky lg:top-44 self-start">
      {% if match.videos %}
        <div class="club-card space-y-4">
          <h2 class="cond text-2xl font-bold">Video</h2>
          {{ match.videos }}
        </div>
      {% endif %}

      {% if match.lineup or match.substitutes %}
        <div class="club-card">
          {% for group in [{title: 'Sestava', items: match.lineup}, {title: 'Náhradníci', items: match.substitutes}] %}
            {% if group.items %}
              <h2 class="cond text-2xl font-bold {{ loop.first ? 'mb-3' : 'mt-6 mb-2 text-xl' }}">{{ group.title }}</h2>
              <ul class="text-sm space-y-1.5">
                {% for p in group.items %}
                  <li class="flex gap-3">
                    <span class="w-6 text-right tnum font-semibold {{ p.partner ? 'text-blueink' : (loop.parent.loop.first ? 'text-redink' : 'text-muted') }}">{{ p.number }}</span>
                    <a href="{{ p.url }}" class="hover:text-redink">{{ p.name }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </aside>
  </div>
</article>
