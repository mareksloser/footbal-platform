<article{{ attributes.addClass('group', 'bg-card', 'border', 'border-line', 'rounded-xl', 'p-5', 'h-full') }}>
  {{ title_prefix }}
  <h3{{ title_attributes.addClass('cond', 'text-2xl', 'font-bold', 'leading-tight') }}><a href="{{ url }}" rel="bookmark" class="group-hover:text-redink">{{ label }}</a></h3>
  {{ title_suffix }}
  <div{{ content_attributes.addClass('mt-2', 'text-muted', 'text-sm') }}>{{ content }}</div>
</article>
