{#
/**
 * @file
 * Výchozí node – plné zobrazení v úzkém sloupci (článek, stránka).
 * Nadpis tiskne blok Nadpis stránky v regionu page_header.
 */
#}
<article{{ attributes.addClass('mx-auto', 'max-w-3xl', 'px-4', 'sm:px-6', 'py-12') }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes.addClass('cond', 'text-3xl', 'font-bold', 'mb-4') }}><a href="{{ url }}" rel="bookmark" class="hover:text-redink">{{ label }}</a></h2>
  {% endif %}
  {{ title_suffix }}
  <div{{ content_attributes.addClass('club-prose') }}>{{ content }}</div>
</article>
