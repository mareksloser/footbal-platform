{#
/**
 * @file
 * View „partners“.
 * - S CSS třídou „club-partner-levels“ (stránka /partneri): skupiny podle úrovně.
 * - Jinak (pás na úvodní stránce): mřížka dlaždic s logy.
 */
#}
{% if club_partner_groups %}
  {% for group in club_partner_groups %}
    <section class="{{ not loop.first ? 'mt-14' }}">
      <h2 class="cond text-3xl font-bold mb-6">{{ group.label }}</h2>
      <div class="grid gap-4 {{ group.key == 'main' ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3' }}">
        {% for row in group.rows %}<div{{ row.attributes.addClass('h-full') }}>{{ row.content }}</div>{% endfor %}
      </div>
    </section>
  {% endfor %}
{% else %}
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    {% for row in rows %}<div{{ row.attributes }}>{{ row.content }}</div>{% endfor %}
  </div>
{% endif %}
