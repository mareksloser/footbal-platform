{#
/**
 * @file
 * View „teams“ – karty týmů, s CSS třídou „club-team-groups“ rozdělené
 * na Dospělí / Mládež podle pole field_team_group.
 */
#}
{% set groups = club_team_groups ?: [{label: null, rows: rows}] %}
{% for group in groups %}
  <section class="{{ not loop.first ? 'mt-14' }}">
    {% if group.label %}<h2 class="cond text-3xl font-bold mb-5">{{ group.label }}</h2>{% endif %}
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for row in group.rows %}<div{{ row.attributes.addClass('h-full') }}>{{ row.content }}</div>{% endfor %}
    </div>
  </section>
{% endfor %}
