{#
/**
 * @file
 * Výchozí neformátovaný seznam. Pokud view má CSS třídu „club-months“,
 * club.theme připraví club_groups a řádky se rozdělí podle měsíců.
 */
#}
{% if club_groups %}
  {% for group in club_groups %}
    <section class="{{ not loop.first ? 'mt-12' }}">
      {% if group.label %}<h2 class="cond text-3xl font-bold mb-2 first-letter:uppercase">{{ group.label }}</h2>{% endif %}
      <div class="divide-y divide-line border-y border-line">
        {% for row in group.rows %}<div{{ row.attributes }}>{{ row.content }}</div>{% endfor %}
      </div>
    </section>
  {% endfor %}
{% else %}
  {% if title %}<h3>{{ title }}</h3>{% endif %}
  {% for row in rows %}
    {% set row_classes = [default_row_class ? 'views-row'] %}
    <div{{ row.attributes.addClass(row_classes) }}>{{ row.content }}</div>
  {% endfor %}
{% endif %}
