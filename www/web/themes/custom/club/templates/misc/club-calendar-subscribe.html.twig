{#
/**
 * @file
 * Odběr kalendáře (iCal) – karta s tlačítky.
 * Proměnné: ics_url, webcal_url, google_url, team_label.
 */
#}
<div class="club-card flex flex-col md:flex-row md:items-center justify-between gap-4">
  <div class="flex items-start gap-3 min-w-0">
    <span class="shrink-0 grid place-items-center h-10 w-10 rounded-lg bg-red/10 text-redink" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/></svg>
    </span>
    <div class="min-w-0">
      <p class="font-semibold">Kalendář {{ team_label ?: 'celého klubu' }} v telefonu</p>
      <p class="text-sm text-muted">Zápasy, turnaje a akce se vám samy objeví v kalendáři a změny termínů se propíšou.</p>
    </div>
  </div>
  <div class="flex flex-wrap gap-2 shrink-0">
    <a href="{{ webcal_url }}" class="h-10 px-4 inline-flex items-center rounded-md bg-ink text-bg text-sm font-semibold hover:opacity-90">iPhone / Outlook</a>
    <a href="{{ google_url }}" target="_blank" rel="noopener" class="h-10 px-4 inline-flex items-center rounded-md border border-line text-sm font-semibold hover:bg-surface">Google Kalendář</a>
    <button type="button" data-club-copy="{{ ics_url }}" class="h-10 px-4 inline-flex items-center rounded-md border border-line text-sm font-semibold hover:bg-surface">Kopírovat odkaz</button>
  </div>
</div>
