<?php

/**
 * @file
 * Preprocess funkce tématu Club.
 *
 * Šablony dostávají připravená data v proměnné `club`, aby v Twigu nebylo
 * potřeba procházet reference a formátovat data.
 */

declare(strict_types=1);

use Drupal\block\Entity\Block;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Url;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/* ------------------------------------------------------------------------
 * Název klubu a barvy z nastavení tématu
 * --------------------------------------------------------------------- */

/**
 * Název klubu z nastavení tématu (Vzhled › Nastavení › Club).
 *
 * @return array{name: string, short_name: string}
 *   name = celý název (např. do pruhu společného týmu), short_name = krátký
 *   název, podle kterého se zvýrazňuje náš řádek v tabulkách. Prázdné
 *   hodnoty se doplní z názvu webu.
 */
function _club_brand(): array {
  $brand = &drupal_static(__FUNCTION__);
  if ($brand === NULL) {
    $site = (string) \Drupal::config('system.site')->get('name');
    $name = trim((string) theme_get_setting('club_title', 'club')) ?: $site;
    $short = trim((string) theme_get_setting('club_short_name', 'club')) ?: $name;
    $brand = ['name' => $name, 'short_name' => $short];
  }
  return $brand;
}

/**
 * Implements hook_preprocess().
 *
 * Název klubu je k dispozici ve všech šablonách jako `club_brand`.
 */
function club_preprocess(array &$variables, string $hook): void {
  $variables['club_brand'] = _club_brand();
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Barvy z nastavení tématu přepíšou CSS proměnné --club-* (viz src/club.css).
 */
function club_page_attachments_alter(array &$attachments): void {
  // Theme hooky se volají jen pro aktivní téma, administrace má vlastní.
  $css = _club_color_css();
  if ($css === '') {
    return;
  }
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'style',
      '#value' => \Drupal\Core\Render\Markup::create($css),
      '#attributes' => ['id' => 'club-colors'],
      '#weight' => 100,
    ],
    'club_colors',
  ];
  CacheableMetadata::createFromRenderArray($attachments)
    ->addCacheTags(['config:club.settings'])
    ->applyTo($attachments);
}

/**
 * Barvy, které lze nastavit v nastavení tématu.
 *
 * Klíč = název CSS proměnné bez prefixu --club-, hodnota = [popisek, výchozí
 * barva ve světlém režimu, výchozí barva v tmavém režimu]. Výchozí hodnoty
 * odpovídají src/club.css.
 *
 * @return array<string, array{0: string, 1: string, 2: string}>
 */
function _club_color_definitions(): array {
  return [
    'red' => ['Hlavní barva (tlačítka, lišta akcí, zvýraznění)', '#d3012b', '#d3012b'],
    'redink' => ['Hlavní barva – text a odkazy', '#be0026', '#ff687c'],
    'blue' => ['Doplňková barva (společné týmy, štítky)', '#1c4ea8', '#3468c8'],
    'blueink' => ['Doplňková barva – text', '#1c4ea8', '#80a6f0'],
    'win' => ['Výhra', '#16803d', '#22a050'],
    'draw' => ['Remíza', '#787e88', '#6e747e'],
  ];
}

/**
 * Sestaví CSS s přepsanými proměnnými. Prázdný řetězec = vše výchozí.
 */
function _club_color_css(): string {
  $colors = theme_get_setting('colors', 'club');
  if (!is_array($colors)) {
    return '';
  }
  // Nevlastní (unlayered) styl má přednost před @layer base v club.css, proto
  // u každé upravené barvy vypíšeme obě varianty – jinak by barva ze
  // světlého režimu přebila výchozí barvu tmavého režimu.
  $vars = ['light' => [], 'dark' => []];
  foreach (_club_color_definitions() as $key => [, $default_light, $default_dark]) {
    $values = [];
    foreach (['light' => $default_light, 'dark' => $default_dark] as $mode => $default) {
      $value = strtolower(trim((string) ($colors[$mode][$key] ?? '')));
      $values[$mode] = preg_match('/^#[0-9a-f]{6}$/', $value) ? $value : $default;
    }
    if ($values['light'] === $default_light && $values['dark'] === $default_dark) {
      continue;
    }
    foreach ($values as $mode => $value) {
      $rgb = implode(' ', array_map('hexdec', str_split(substr($value, 1), 2)));
      $vars[$mode][] = "--club-$key: $rgb;";
    }
  }
  $css = '';
  if ($vars['light']) {
    $css .= ':root{' . implode('', $vars['light']) . '}';
  }
  if ($vars['dark']) {
    $dark = implode('', $vars['dark']);
    $css .= '@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){' . $dark . '}}';
    $css .= ':root[data-theme="dark"]{' . $dark . '}';
  }
  return $css;
}

/* ------------------------------------------------------------------------
 * Stránka
 * --------------------------------------------------------------------- */

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function club_preprocess_page(array &$variables): void {
  $variables['logo_url'] = theme_get_setting('logo.url');
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $variables['year'] = date('Y');

  foreach (['cta_label', 'cta_label_mobile', 'club_name', 'club_address', 'club_email', 'footer_note'] as $key) {
    $variables[$key] = theme_get_setting($key);
  }
  $variables['cta_url'] = _club_url_string((string) theme_get_setting('cta_url'));

  // Šedé záhlaví se skrývá jen na „nástěnce“ týmu (úvod, /tym/u15),
  // stránka /tym/u15/o-tymu ho má.
  $node = $variables['node'] ?? NULL;
  $canonical = \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical';
  $variables['is_team_page'] = $node instanceof NodeInterface && $node->bundle() === 'team' && $canonical;
  // Detail zápasu má vlastní záhlaví se skóre (node--match--full).
  $variables['hide_page_header'] = $variables['is_team_page']
    || ($node instanceof NodeInterface && in_array($node->bundle(), ['match', 'player', 'event', 'tournament', 'project'], TRUE) && $canonical);

  $cache = CacheableMetadata::createFromRenderArray($variables)
    ->addCacheTags(['config:system.site', 'config:club.settings']);
  $variables['footer'] = _club_footer($cache);
  $cache->applyTo($variables);
}

/**
 * Data patičky – nábor, partneři, kontakt, týmy, areál, spodní lišta.
 */
function _club_footer(CacheableMetadata $cache): array {
  $setting = static fn(string $key): ?string => trim((string) theme_get_setting($key)) ?: NULL;
  $url = static fn(string $key): ?string => _club_url_string((string) theme_get_setting($key));

  // Náborový pruh.
  $recruit = NULL;
  if ($setting('recruit_title') || $setting('recruit_text')) {
    $recruit = [
      'title' => $setting('recruit_title'),
      'text' => $setting('recruit_text'),
      'label' => $setting('recruit_label') ?: $setting('cta_label'),
      'url' => _club_url_string((string) theme_get_setting('cta_url')),
      'second_label' => $setting('recruit_second_label'),
      'second_url' => $url('recruit_second_url'),
    ];
  }

  // Sociální sítě – Instagram z modulu club_instagram.
  $socials = [];
  if (\Drupal::moduleHandler()->moduleExists('club_instagram')) {
    $config = \Drupal::config('club_instagram.settings');
    $cache->addCacheableDependency($config);
    $handle = (string) $config->get('handle');
    $instagram = $config->get('profile_url') ?: ($handle !== '' ? 'https://www.instagram.com/' . $handle . '/' : NULL);
    if ($instagram) {
      $socials[] = ['key' => 'instagram', 'label' => 'Instagram', 'url' => $instagram];
    }
  }
  foreach (['facebook' => 'Facebook', 'youtube' => 'YouTube'] as $key => $label) {
    if ($value = $setting('social_' . $key)) {
      $socials[] = ['key' => $key, 'label' => $label, 'url' => $value];
    }
  }

  // Partneři se zaškrtnutým „Zobrazit v patičce“ (na úvodní stránce ne – ta má vlastní sekci).
  $cache->addCacheContexts(['url.path.is_front']);
  $partners = [];
  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    $partners = _club_footer_partners($cache);
  }

  $phone = $setting('club_phone');
  return [
    'recruit' => $recruit,
    'partners' => $partners,
    'partner_cta_url' => $url('partner_cta_url'),
    'ico' => $setting('club_ico'),
    'phone' => $phone,
    'phone_href' => $phone ? 'tel:' . preg_replace('/[^0-9+]/', '', $phone) : NULL,
    'socials' => $socials,
    'team_groups' => _club_footer_teams($cache),
    'venue_address' => $setting('venue_address'),
    'venue_map_url' => $setting('venue_map_url'),
    'training_note' => $setting('training_note'),
    'privacy_url' => $url('privacy_url'),
    'cookies_url' => $url('cookies_url'),
    'login_url' => Url::fromRoute('user.page')->toString(),
  ];
}

/**
 * Partneři do patičky – logo (nebo název) a odkaz.
 */
function _club_footer_partners(CacheableMetadata $cache): array {
  $cache->addCacheTags(['taxonomy_term_list:partner']);
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('taxonomy_term', 'partner');
  if (!isset($definitions['field_partner_footer'])) {
    return [];
  }
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'partner')
    ->condition('status', 1)
    ->condition('field_partner_footer', 1)
    ->sort('weight')
    ->sort('name')
    ->execute();
  $partners = [];
  foreach ($storage->loadMultiple($ids) as $term) {
    $media = _club_ref($term, 'field_logo');
    $cache->addCacheableDependency($term);
    if ($media) {
      $cache->addCacheableDependency($media);
    }
    $partners[] = [
      'name' => $term->label(),
      'url' => $term->hasField('field_link') && !$term->get('field_link')->isEmpty()
        ? $term->get('field_link')->first()->getUrl()->toString()
        : NULL,
      'logo_url' => _club_image_url($media, 'club_logo'),
    ];
  }
  return $partners;
}

/**
 * Týmy do patičky po skupinách (pole field_team_group – Dospělí / Mládež…).
 */
function _club_footer_teams(CacheableMetadata $cache): array {
  if (!\Drupal::hasService('club_core.team_context')) {
    return [];
  }
  $cache->addCacheTags(['node_list:team']);
  $context = \Drupal::service('club_core.team_context');
  $groups = [];
  $order = [];
  foreach ($context->getTeams() as $team) {
    if ($context->isClub($team)) {
      continue;
    }
    if (!$order && $team->hasField('field_team_group')) {
      $allowed = $team->getFieldDefinition('field_team_group')->getFieldStorageDefinition()->getSetting('allowed_values') ?: [];
      $order = array_flip(array_keys($allowed));
    }
    $key = (string) (_club_value($team, 'field_team_group') ?? '');
    $groups[$key] ??= ['label' => $key !== '' ? _club_list_label($team, 'field_team_group') : NULL, 'teams' => []];
    $short = $team->hasField('field_short_title') ? $team->get('field_short_title')->value : NULL;
    $url = $team->toUrl()->toString(TRUE);
    $cache->addCacheableDependency($url)->addCacheableDependency($team);
    $groups[$key]['teams'][] = ['label' => $short ?: $team->label(), 'url' => $url->getGeneratedUrl()];
  }
  uksort($groups, static fn($a, $b) => ($order[$a] ?? PHP_INT_MAX) <=> ($order[$b] ?? PHP_INT_MAX));
  // Jediná skupina nepotřebuje podnadpis.
  if (count($groups) === 1) {
    $groups[array_key_first($groups)]['label'] = NULL;
  }
  return array_values($groups);
}

/**
 * Implements hook_preprocess_HOOK() for page-title.html.twig.
 *
 * Na stránce „O týmu“ přidá pod nadpis soutěž a trenéra.
 */
function club_preprocess_page_title(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $variables['#cache']['contexts'][] = 'route';

  // Perex stránky (pole field_lead) pod nadpisem – O klubu, Nábor…
  $node = $route_match->getParameter('node');
  if ($route_match->getRouteName() === 'entity.node.canonical' && $node instanceof NodeInterface) {
    $variables['subtitle'] = _club_value($node, 'field_lead');
    $variables['#cache']['tags'][] = 'node:' . $node->id();
    // Aktualita: datum a týmy pod perexem.
    if ($node->bundle() === 'article') {
      $variables['meta_date'] = _club_date_parts((int) $node->getCreatedTime())['long'];
      $variables['meta_teams'] = [];
      if ($node->hasField('field_team')) {
        foreach ($node->get('field_team')->referencedEntities() as $team) {
          $variables['meta_teams'][] = [
            'label' => _club_is_club($team) ? 'Klub' : (_club_value($team, 'field_short_title') ?? $team->label()),
            'merged' => (bool) _club_ref($team, 'field_partner_club'),
            'club' => _club_is_club($team),
          ];
        }
      }
    }
    return;
  }
  if ($route_match->getRouteName() !== 'club_core.team_detail') {
    return;
  }
  $team = $route_match->getParameter('node');
  if (!$team instanceof NodeInterface) {
    return;
  }
  $parts = [];
  if ($competition = _club_ref($team, 'field_competition')) {
    $parts[] = $competition->label() . '.';
  }
  if ($coach = _club_team_coach($team)) {
    $parts[] = 'Trenér ' . $coach . '.';
  }
  $variables['subtitle'] = implode(' ', $parts);
  $variables['team_merged'] = (bool) _club_ref($team, 'field_partner_club');
  $variables['partner_name'] = _club_ref($team, 'field_partner_club')?->label();
}

/**
 * Jméno trenéra z realizačního týmu (první role začínající „Trenér“).
 */
function _club_team_coach(NodeInterface $team): ?string {
  if (!$team->hasField('field_staff')) {
    return NULL;
  }
  foreach ($team->get('field_staff')->referencedEntities() as $member) {
    $role = mb_strtolower((string) _club_value($member, 'field_role'));
    if (str_starts_with($role, 'trenér') || str_starts_with($role, 'hlavní trenér')) {
      return _club_ref($member, 'field_person')?->label() ?? _club_value($member, 'field_person_name');
    }
  }
  return NULL;
}

/**
 * Implements hook_preprocess_HOOK() for node--page.
 *
 * Popisek pole Text u stránky nikdy nezobrazovat (nadpis tiskne záhlaví).
 */
function club_preprocess_node__page(array &$variables): void {
  foreach (['field_body', 'body'] as $field) {
    if (isset($variables['content'][$field])) {
      $variables['content'][$field]['#label_display'] = 'hidden';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--callout.
 */
function club_preprocess_paragraph__callout(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $links = [];
  if ($paragraph->hasField('field_links')) {
    foreach ($paragraph->get('field_links') as $item) {
      $links[] = ['url' => $item->getUrl()->toString(), 'title' => $item->title ?: $item->getUrl()->toString()];
    }
  }
  $variables['club'] = [
    'title' => _club_value($paragraph, 'field_title'),
    'style' => _club_value($paragraph, 'field_style') ?? 'blue',
    'badge' => _club_value($paragraph, 'field_badge'),
    'links' => $links,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--info-card.
 */
function club_preprocess_paragraph__info_card(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $link = NULL;
  if ($paragraph->hasField('field_link') && !$paragraph->get('field_link')->isEmpty()) {
    $item = $paragraph->get('field_link')->first();
    $link = ['url' => $item->getUrl()->toString(), 'title' => $item->title ?: 'Více'];
  }
  $variables['club'] = [
    'title' => _club_value($paragraph, 'field_title'),
    'link' => $link,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--partners.
 *
 * Loga ze slovníku Partner (pole field_logo = media Obrázek, field_link).
 */
function club_preprocess_paragraph__partners(array &$variables): void {
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheTags(['taxonomy_term_list:partner']);
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'partner')
    ->condition('status', 1)
    ->sort('weight')
    ->sort('name')
    ->execute();
  $partners = [];
  foreach ($storage->loadMultiple($ids) as $term) {
    $cache->addCacheableDependency($term);
    $url = NULL;
    if ($term->hasField('field_link') && !$term->get('field_link')->isEmpty()) {
      $url = $term->get('field_link')->first()->getUrl()->toString();
    }
    $partners[] = [
      'name' => $term->label(),
      'logo_url' => _club_image_url(_club_ref($term, 'field_logo')),
      'url' => $url,
    ];
  }
  $variables['club'] = [
    'title' => _club_value($variables['paragraph'], 'field_title'),
    'partners' => $partners,
  ];
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--contacts.
 *
 * Kompaktní kontakty vedení klubu (ze club_core). Volitelné pole
 * field_contact_group omezí výpis na jednu skupinu (Výkonný výbor…).
 */
function club_preprocess_paragraph__contacts(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['club'] = [
    'title' => _club_value($paragraph, 'field_title') ?? 'Vedení a kontakty',
    'items' => [],
    'contacts_url' => NULL,
  ];
  if (!\Drupal::hasService('club_core.contacts_builder')) {
    return;
  }
  $build = \Drupal::service('club_core.contacts_builder')->build();
  $group = _club_ref($paragraph, 'field_contact_group');
  foreach ($build['#sections'] ?? [] as $section) {
    if ($group ? (string) $section['group_id'] === (string) $group->id() : TRUE) {
      array_push($variables['club']['items'], ...$section['items']);
      if (!$group) {
        // Bez zvolené skupiny jen první skupina (Vedení klubu).
        break;
      }
    }
  }
  try {
    $variables['club']['contacts_url'] = Url::fromRoute('club_core.contacts')->toString();
  }
  catch (\Exception) {
  }
  CacheableMetadata::createFromRenderArray($variables)
    ->merge(CacheableMetadata::createFromRenderArray($build))
    ->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--training.
 */
function club_preprocess_paragraph__training(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['club'] = [
    'day' => _club_list_label($paragraph, 'field_day'),
    'from' => _club_value($paragraph, 'field_time_from'),
    'to' => _club_value($paragraph, 'field_time_to'),
    'venue' => _club_ref($paragraph, 'field_venue')?->label(),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--staff-member.
 */
function club_preprocess_paragraph__staff_member(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $person = _club_ref($paragraph, 'field_person');
  if ($person) {
    CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($person)->applyTo($variables);
  }
  $phone = _club_value($person, 'field_phone');
  if ($phone && class_exists('\\Drupal\\club_core\\ContactsBuilder')) {
    $phone_display = \Drupal\club_core\ContactsBuilder::formatPhone($phone);
  }
  $variables['club'] = [
    'phone_display' => $phone_display ?? $phone,
    'role' => _club_value($paragraph, 'field_role'),
    'name' => $person?->label() ?? _club_value($paragraph, 'field_person_name'),
    'email' => _club_value($person, 'field_email') ?? _club_value($paragraph, 'field_email'),
    'phone' => $phone,
    'phone_href' => $phone ? preg_replace('/[^\d+]/', '', $phone) : NULL,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function club_preprocess_block(array &$variables): void {
  $variables['region'] = NULL;
  if (!empty($variables['elements']['#id']) && ($block = Block::load($variables['elements']['#id']))) {
    $variables['region'] = $block->getRegion();
  }
  // Menu v hlavičce dostane vlastní šablonu s rozbalovacími podmenu.
  if (in_array($variables['region'], ['header_left', 'header_right'], TRUE)
    && in_array($variables['base_plugin_id'] ?? '', ['system_menu_block', 'menu_block'], TRUE)) {
    $variables['content']['#attributes']['data-club-region'] = 'header';
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu--club-header.
 *
 * U odkazů na společný tým (stránka týmu nebo /tym/u19/o-tymu) přidá
 * do podmenu štítek společného týmu (text v nastavení tématu).
 */
function club_preprocess_menu__club_header(array &$variables): void {
  if (!\Drupal::hasService('club_core.team_context') || empty($variables['items'])) {
    return;
  }
  $context = \Drupal::service('club_core.team_context');
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $label = theme_get_setting('merged_label') ?: 'společný tým';

  $walk = static function (array &$items) use (&$walk, $context, $storage, $label): void {
    foreach ($items as &$item) {
      $item['club_merged'] = NULL;
      $url = $item['url'] ?? NULL;
      if ($url instanceof Url && $url->isRouted()) {
        $param = $url->getRouteParameters()['node'] ?? NULL;
        $team = NULL;
        if ($param !== NULL && in_array($url->getRouteName(), ['club_core.team_detail', 'entity.node.canonical'], TRUE)) {
          $team = ctype_digit((string) $param) ? $storage->load($param) : $context->loadBySlug((string) $param);
        }
        if ($team instanceof NodeInterface && $team->bundle() === 'team' && $context->isMerged($team)) {
          $item['club_merged'] = $label;
        }
      }
      if (!empty($item['below'])) {
        $walk($item['below']);
      }
    }
  };
  $walk($variables['items']);
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 *
 * Stránky z Views (ne bloky) dostanou kontejner jako zbytek webu.
 */
function club_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  $variables['is_page'] = $view->display_handler->getPluginId() === 'page';

  // Kalendář: nad seznamem nabídka odběru do telefonu (blok ze club_core).
  if ($view->id() === 'calendar' && $variables['is_page']) {
    $manager = \Drupal::service('plugin.manager.block');
    if ($manager->hasDefinition('club_calendar_subscribe')) {
      $variables['club_subscribe'] = $manager->createInstance('club_calendar_subscribe')->build();
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view-unformatted.html.twig.
 *
 * Řádky rozdělené podle měsíců (pole field_date) – kalendář a archiv zápasů.
 */
function club_preprocess_views_view_unformatted(array &$variables): void {
  $view = $variables['view'];

  $css_class = (string) $view->display_handler->getOption('css_class');
  // Partneři po úrovních (CSS třída „club-partner-levels“).
  if (str_contains($css_class, 'club-partner-levels')) {
    $variables['club_partner_groups'] = _club_list_groups($view, $variables['rows'], 'field_partner_level', 'partner', 'Partneři');
    return;
  }
  // Projekty po stavech Probíhá / Plánujeme / Hotovo (CSS třída „club-project-groups“).
  if (str_contains($css_class, 'club-project-groups')) {
    $variables['club_project_groups'] = _club_list_groups($view, $variables['rows'], 'field_project_status', 'planned', 'Projekty');
    return;
  }
  // Týmy po skupinách Dospělí / Mládež (CSS třída „club-team-groups“).
  if (str_contains($css_class, 'club-team-groups')) {
    $variables['club_team_groups'] = _club_list_groups($view, $variables['rows'], 'field_team_group', 'youth', 'Týmy');
    return;
  }
  // Kalendář vždy, ostatní views s CSS třídou „club-months“ (archiv zápasů…).
  $css = (string) $view->display_handler->getOption('css_class');
  if ($view->id() !== 'calendar' && !str_contains($css, 'club-months')) {
    return;
  }
  $groups = [];
  foreach ($variables['rows'] as $index => $row) {
    $entity = $view->result[$index]->_entity ?? NULL;
    $timestamp = $entity instanceof FieldableEntityInterface ? _club_timestamp($entity, 'field_date') : NULL;
    $label = $timestamp ? _club_date_parts($timestamp)['month_year'] : '';
    $groups[$label] ??= ['label' => $label, 'rows' => []];
    $groups[$label]['rows'][] = $row;
  }
  $variables['club_groups'] = array_values($groups);
}

/**
 * Rozdělí řádky view podle hodnoty list pole (úroveň partnera, skupina týmu).
 * Pořadí skupin = pořadí povolených hodnot pole, v rámci skupiny pořadí z view.
 */
function _club_list_groups($view, array $rows, string $field, string $default_key, string $default_label): array {
  $groups = [];
  $order = [];
  foreach ($rows as $index => $row) {
    $entity = $view->result[$index]->_entity ?? NULL;
    $has = $entity instanceof FieldableEntityInterface && $entity->hasField($field);
    $key = $has ? (_club_value($entity, $field) ?? $default_key) : $default_key;
    if (!$order && $has) {
      $order = array_flip(array_keys($entity->get($field)->getFieldDefinition()->getFieldStorageDefinition()->getSetting('allowed_values') ?? []));
    }
    $groups[$key] ??= [
      'key' => $key,
      'label' => $has ? (_club_list_label($entity, $field) ?? $default_label) : $default_label,
      'rows' => [],
    ];
    $groups[$key]['rows'][] = $row;
  }
  uksort($groups, static fn($a, $b) => ($order[$a] ?? 99) <=> ($order[$b] ?? 99));
  return array_values($groups);
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy-term--partner.
 */
function club_preprocess_taxonomy_term__partner(array &$variables): void {
  $term = $variables['term'];
  $url = NULL;
  if ($term->hasField('field_link') && !$term->get('field_link')->isEmpty()) {
    $url = $term->get('field_link')->first()->getUrl()->toString();
  }
  $media = _club_ref($term, 'field_logo');
  if ($media) {
    CacheableMetadata::createFromRenderArray($variables)->addCacheableDependency($media)->applyTo($variables);
  }
  $variables['club'] = [
    'name' => $term->label(),
    'url' => $url,
    'host' => $url ? preg_replace('/^www\./', '', (string) parse_url($url, PHP_URL_HOST)) : NULL,
    'logo_url' => _club_image_url($media, 'club_logo'),
    'level' => _club_value($term, 'field_partner_level'),
    'level_label' => _club_list_label($term, 'field_partner_level'),
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for menu.
 */
function club_theme_suggestions_menu_alter(array &$suggestions, array $variables): void {
  if (($variables['attributes']['data-club-region'] ?? NULL) === 'header') {
    $suggestions[] = 'menu__club_header';
  }
}

/* ------------------------------------------------------------------------
 * Nody
 * --------------------------------------------------------------------- */

/**
 * Implements hook_preprocess_HOOK() for node--team.
 */
function club_preprocess_node__team(array &$variables): void {
  $node = $variables['node'];
  $partner = _club_ref($node, 'field_partner_club');
  $variables['club'] = [
    'merged' => (bool) $partner,
    'partner_name' => $partner?->label(),
    'partner_short' => _club_value($partner, 'field_short_name') ?? _club_initials((string) $partner?->label()),
  ];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  if ($partner) {
    $cache->addCacheableDependency($partner);
  }
  if ($variables['view_mode'] === 'card') {
    $variables['club_card'] = _club_team_card($node, $cache);
  }
  $cache->applyTo($variables);
}

/**
 * Data pro kartu týmu na stránce /tymy: soutěž, trenér, počet hráčů, příští zápas.
 */
function _club_team_card(NodeInterface $team, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:player', 'node_list:match', 'node_list:tournament']);
  // Příští zápas se mění s časem.
  $cache->setCacheMaxAge(3600);

  $competition = _club_ref($team, 'field_competition');
  if ($competition) {
    $cache->addCacheableDependency($competition);
  }

  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  $players = (int) $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'player')
    ->condition('status', 1)
    ->condition('field_team', $team->id())
    ->count()
    ->execute();

  // Nejbližší zápas nebo turnaj, který ještě neskončil (Smart Date ukládá timestampy).
  $next = NULL;
  $ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', ['match', 'tournament'], 'IN')
    ->condition('status', 1)
    ->condition('field_team', $team->id())
    ->condition('field_date.end_value', \Drupal::time()->getRequestTime(), '>=')
    ->sort('field_date.value', 'ASC')
    ->range(0, 1)
    ->execute();
  if ($ids && ($event = $node_storage->load(reset($ids)))) {
    $timestamp = _club_timestamp($event, 'field_date');
    $date = $timestamp ? _club_date_parts($timestamp) : [];
    if ($event->bundle() === 'match') {
      $opponent = _club_ref($event, 'field_opponent');
      $home = _club_value($event, 'field_is_home');
      $what = (($home === NULL || $home) ? 'doma' : 'venku') . ($opponent ? ' s ' . $opponent->label() : '');
    }
    else {
      $what = $event->label();
    }
    $next = trim(($date['short'] ?? '') . ' ' . ($date['time'] ?? '')) . ', ' . $what;
  }

  $slug = _club_value($team, 'field_slug');
  try {
    $url = Url::fromRoute('club_core.team_detail', ['node' => $slug ?? $team->id()])->toString();
  }
  catch (\Exception) {
    $url = $team->toUrl()->toString();
  }

  $partner = _club_ref($team, 'field_partner_club');
  return [
    'url' => $url,
    'competition' => $competition?->label(),
    'coach' => _club_team_coach($team),
    'players' => $players,
    'next' => $next,
    'merged' => (bool) $partner,
    'partner_name' => $partner?->label(),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for node--match (všechny view mody).
 */
function club_preprocess_node__match(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);

  $team = _club_ref($node, 'field_team');
  $opponent = _club_ref($node, 'field_opponent');
  $partner = _club_ref($team, 'field_partner_club');
  foreach ([$team, $opponent, $partner] as $entity) {
    if ($entity) {
      $cache->addCacheableDependency($entity);
    }
  }

  $is_home = _club_value($node, 'field_is_home');
  $is_home = $is_home === NULL ? TRUE : (bool) $is_home;
  $us_name = _club_value($team, 'field_display_name') ?? _club_brand()['short_name'];
  $opponent_name = $opponent?->label() ?? '';

  $us = _club_value($node, 'field_score_us');
  $them = _club_value($node, 'field_score_them');
  $played = $us !== NULL && $them !== NULL;
  $result = NULL;
  if ($played) {
    $result = (int) $us <=> (int) $them;
    $result = [1 => 'V', 0 => 'R', -1 => 'P'][$result];
  }

  $timestamp = _club_timestamp($node, 'field_date');
  $date = $timestamp ? _club_date_parts($timestamp) : [];

  $team_info = _club_team_info($team, $cache);

  $variables['club'] = $team_info + [
    'is_home' => $is_home,
    'us_name' => $us_name,
    'opponent_name' => $opponent_name,
    'opponent_initials' => _club_initials($opponent_name),
    'opponent_logo' => _club_image_url(_club_ref($opponent, 'field_logo')),
    'home_name' => $is_home ? $us_name : $opponent_name,
    'away_name' => $is_home ? $opponent_name : $us_name,
    'home_score' => $played ? ($is_home ? $us : $them) : NULL,
    'away_score' => $played ? ($is_home ? $them : $us) : NULL,
    'played' => $played,
    'result' => $result,
    'date' => $date,
    'when' => $timestamp ? _club_relative_day($timestamp) : NULL,
    'kicker' => 'Příští zápas' . ($team && !_club_is_club($team) ? ', ' . $team->label() : ''),
    'venue' => _club_ref($node, 'field_venue')?->label(),
    'competition' => _club_ref($node, 'field_competition')?->label(),
    'club_logo' => theme_get_setting('logo.url'),
    'partner_short' => $partner ? (_club_value($partner, 'field_short_name') ?? _club_initials((string) $partner->label())) : NULL,
  ];

  if ($variables['view_mode'] === 'full') {
    $variables['match'] = _club_match_detail($node, $team, $is_home, $cache);
  }

  // „Za 2 dny“ se mění s časem – teaser/hero cachujeme nejdéle do půlnoci.
  if ($variables['view_mode'] === 'hero') {
    $cache->setCacheMaxAge(strtotime('tomorrow') - \Drupal::time()->getRequestTime());
  }
  $cache->applyTo($variables);
}

/**
 * Data pro detail zápasu: průběh, sestava, videa, trenér, stav.
 */
function _club_match_detail(NodeInterface $node, ?FieldableEntityInterface $team, bool $is_home, CacheableMetadata $cache): array {
  $labels = [
    'goal' => 'Gól',
    'penalty' => 'Gól z penalty',
    'own_goal' => 'Vlastní gól',
    'yellow' => 'Žlutá karta',
    'second_yellow' => 'Druhá žlutá karta',
    'red' => 'Červená karta',
  ];

  // Průběh zápasu z paragraphs Událost zápasu.
  $events = [];
  if ($node->hasField('field_match_events')) {
    foreach ($node->get('field_match_events')->referencedEntities() as $index => $paragraph) {
      $cache->addCacheableDependency($paragraph);
      $player = _club_ref($paragraph, 'field_player');
      $assist = _club_ref($paragraph, 'field_assist');
      foreach ([$player, $assist] as $entity) {
        if ($entity) {
          $cache->addCacheableDependency($entity);
        }
      }
      $type = (string) _club_value($paragraph, 'field_event_type');
      $events[] = [
        'minute' => (int) _club_value($paragraph, 'field_minute'),
        'order' => $index,
        'type' => $type,
        'opponent' => (bool) _club_value($paragraph, 'field_is_opponent'),
        'player' => $player?->label(),
        'player_url' => $player?->toUrl()->toString(),
        'assist' => $assist?->label(),
        'assist_url' => $assist?->toUrl()->toString(),
      ];
    }
  }
  usort($events, static fn($a, $b) => [$a['minute'], $a['order']] <=> [$b['minute'], $b['order']]);

  $us = 0;
  $them = 0;
  foreach ($events as &$event) {
    $event['goal'] = in_array($event['type'], ['goal', 'penalty', 'own_goal'], TRUE);
    $event['card'] = match ($event['type']) {
      'yellow' => 'yellow',
      'second_yellow' => 'second_yellow',
      'red' => 'red',
      default => NULL,
    };
    $event['label'] = ($labels[$event['type']] ?? $event['type']) . ($event['opponent'] ? ' soupeře' : '');
    if ($event['goal']) {
      // Vlastní gól soupeře je náš gól a naopak.
      $for_us = $event['type'] === 'own_goal' ? $event['opponent'] : !$event['opponent'];
      $for_us ? $us++ : $them++;
      $event['ours'] = $for_us;
      $event['score'] = $is_home ? $us . ':' . $them : $them . ':' . $us;
    }
    else {
      $event['ours'] = !$event['opponent'];
      $event['score'] = NULL;
    }
  }
  unset($event);

  // Sestava a náhradníci.
  $players = static function (string $field) use ($node, $cache): array {
    if (!$node->hasField($field)) {
      return [];
    }
    $list = [];
    foreach ($node->get($field)->referencedEntities() as $player) {
      $cache->addCacheableDependency($player);
      $list[] = [
        'name' => $player->label(),
        'url' => $player->toUrl()->toString(),
        'number' => _club_value($player, 'field_number'),
        'partner' => (bool) _club_ref($player, 'field_home_club'),
      ];
    }
    return $list;
  };

  // Videa, která odkazují na tento zápas (node video, pole field_match).
  $videos = [];
  $storage_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  if (isset($storage_definitions['field_match'])) {
    $cache->addCacheTags(['node_list:video']);
    $ids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'video')
      ->condition('status', 1)
      ->condition('field_match', $node->id())
      ->sort('created', 'DESC')
      ->range(0, 4)
      ->execute();
    if ($ids) {
      $entities = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($ids);
      $videos = \Drupal::entityTypeManager()->getViewBuilder('node')->viewMultiple($entities, 'teaser');
    }
  }

  // Odkaz na stránku týmu.
  $team_url = NULL;
  if ($team instanceof NodeInterface && !_club_is_club($team)) {
    try {
      $team_url = Url::fromRoute('club_core.team_detail', ['node' => _club_value($team, 'field_slug') ?? $team->id()])->toString();
    }
    catch (\Exception) {
      $team_url = $team->toUrl()->toString();
    }
  }

  $status = _club_value($node, 'field_match_status');
  return [
    'events' => $events,
    'lineup' => $players('field_lineup'),
    'substitutes' => $players('field_substitutes'),
    'videos' => $videos,
    'quote' => _club_value($node, 'field_coach_quote'),
    'coach' => $team instanceof NodeInterface ? _club_team_coach($team) : NULL,
    'team_name' => $team?->label(),
    'team_url' => $team_url,
    'status' => $status,
    'status_label' => in_array($status, ['postponed', 'cancelled'], TRUE) ? _club_list_label($node, 'field_match_status') : NULL,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for node--article.
 */
function club_preprocess_node__article(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $team = _club_team_info(_club_ref($node, 'field_team'), $cache);
  [$image_card, $image_wide, $image_alt] = _club_article_images($node);

  $variables['club'] = [
    'url' => $variables['url'],
    'title' => $node->label(),
    'lead' => _club_article_lead($node),
    'date' => _club_date_parts((int) $node->getCreatedTime())['short'],
    'image_url' => $image_card,
    'logo_url' => theme_get_setting('logo.url'),
    'team_label' => $team['team_label'],
    'team_merged' => $team['team_merged'],
    'team_is_club' => $team['team_is_club'],
    'show_team' => $team['show_team'],
  ];

  if ($variables['view_mode'] === 'full') {
    foreach (['body', 'field_body'] as $field) {
      if (isset($variables['content'][$field])) {
        $variables['content'][$field]['#label_display'] = 'hidden';
      }
    }
    $match = _club_ref($node, 'field_match');
    if ($match) {
      $cache->addCacheableDependency($match);
    }
    $variables['club'] += [
      'image_wide' => $image_wide,
      'image_alt' => $image_alt,
      'match_url' => $match?->toUrl()->toString(),
      'match_label' => $match?->label(),
      'related' => _club_related_articles($node, $cache),
    ];
  }
  $cache->applyTo($variables);
}

/**
 * Perex: pole field_lead, jinak shrnutí těla, jinak začátek textu.
 */
function _club_article_lead(NodeInterface $node): ?string {
  if ($lead = _club_value($node, 'field_lead')) {
    return $lead;
  }
  foreach (['body', 'field_body'] as $field) {
    if (!$node->hasField($field) || $node->get($field)->isEmpty()) {
      continue;
    }
    $item = $node->get($field)->first();
    if (!empty($item->summary)) {
      return trim(strip_tags((string) $item->summary));
    }
    $text = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags((string) $item->value))));
    if (mb_strlen($text) > 180) {
      $text = mb_substr($text, 0, 180);
      $text = mb_substr($text, 0, (int) mb_strrpos($text, ' ')) . '…';
    }
    return $text ?: NULL;
  }
  return NULL;
}

/**
 * Obrázek článku: pole field_image (Obrázek) nebo field_media (media).
 *
 * @return array{0: ?string, 1: ?string, 2: string}
 *   [karta 16:10, široký 16:9, alt]
 */
function _club_article_images(NodeInterface $node): array {
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $item = $node->get('field_image')->first();
    $file = $item->entity;
    return [
      _club_file_image_url($file, 'club_card'),
      _club_file_image_url($file, 'club_wide'),
      (string) ($item->alt ?? ''),
    ];
  }
  $media = _club_ref($node, 'field_media');
  return [_club_image_url($media, 'club_card'), _club_image_url($media, 'club_wide'), ''];
}

/**
 * Tři nejnovější další aktuality stejného týmu (nebo klubu).
 */
function _club_related_articles(NodeInterface $node, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:article']);
  $query = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'article')
    ->condition('status', 1)
    ->condition('nid', $node->id(), '<>')
    ->sort('created', 'DESC')
    ->range(0, 3);
  if ($node->hasField('field_team') && !$node->get('field_team')->isEmpty()) {
    $query->condition('field_team', array_column($node->get('field_team')->getValue(), 'target_id'), 'IN');
  }
  $ids = $query->execute();
  if (!$ids) {
    return [];
  }
  $entities = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($ids);
  return \Drupal::entityTypeManager()->getViewBuilder('node')->viewMultiple($entities, 'teaser');
}

/**
 * Implements hook_preprocess_HOOK() for node--project.
 */
function club_preprocess_node__project(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  [$image_card, $image_wide, $image_alt] = _club_article_images($node);
  $progress = _club_value($node, 'field_project_progress');

  $variables['club'] = [
    'url' => $variables['url'],
    'title' => $node->label(),
    'lead' => _club_article_lead($node),
    'term' => _club_value($node, 'field_project_term'),
    'status' => _club_value($node, 'field_project_status'),
    'status_label' => _club_list_label($node, 'field_project_status'),
    'progress' => $progress === NULL ? NULL : max(0, min(100, (int) $progress)),
    'image_url' => $image_card,
    'logo_url' => theme_get_setting('logo.url'),
  ];

  if ($variables['view_mode'] === 'full') {
    foreach (['body', 'field_body'] as $field) {
      if (isset($variables['content'][$field])) {
        $variables['content'][$field]['#label_display'] = 'hidden';
      }
    }
    $budget = _club_value($node, 'field_project_budget');
    $partners = $node->hasField('field_project_partners') ? $node->get('field_project_partners')->referencedEntities() : [];
    $variables['project'] = [
      'image' => $image_wide,
      'image_alt' => $image_alt,
      'budget' => $budget === NULL ? NULL : number_format((int) $budget, 0, ',', "\u{00A0}") . "\u{00A0}Kč",
      'funding' => _club_value($node, 'field_project_funding'),
      'partners' => $partners ? \Drupal::entityTypeManager()->getViewBuilder('taxonomy_term')->viewMultiple($partners, 'teaser') : [],
      'related' => _club_related_projects($node, $cache),
    ];
  }
  $cache->applyTo($variables);
}

/**
 * Tři další projekty – nejdřív probíhající a plánované, pak nejnovější hotové.
 */
function _club_related_projects(NodeInterface $node, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:project']);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = [];
  foreach ([['running', 'planned'], ['done']] as $statuses) {
    $ids += $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'project')
      ->condition('status', 1)
      ->condition('nid', $node->id(), '<>')
      ->condition('field_project_status', $statuses, 'IN')
      ->sort('created', 'DESC')
      ->range(0, 3)
      ->execute();
  }
  $ids = array_slice($ids, 0, 3, TRUE);
  if (!$ids) {
    return [];
  }
  return \Drupal::entityTypeManager()->getViewBuilder('node')->viewMultiple($storage->loadMultiple($ids), 'teaser');
}

/**
 * Implements hook_preprocess_HOOK() for node--tournament.
 */
function club_preprocess_node__tournament(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $timestamp = _club_timestamp($node, 'field_date');
  $variables['club'] = _club_team_info(_club_ref($node, 'field_team'), $cache) + [
    'date' => $timestamp ? _club_date_parts($timestamp) : [],
    'placement' => _club_value($node, 'field_placement'),
    'venue' => _club_ref($node, 'field_venue')?->label(),
  ];
  if ($variables['view_mode'] === 'full') {
    $variables['tournament'] = _club_tournament_detail($node, $cache);
  }
  $cache->applyTo($variables);
}

/**
 * Detail turnaje: termín, naše zápasy po fázích, bilance, přílohy, fotky.
 */
function _club_tournament_detail(NodeInterface $node, CacheableMetadata $cache): array {
  $now = \Drupal::time()->getRequestTime();
  $start = $node->hasField('field_date') && !$node->get('field_date')->isEmpty() ? (int) $node->get('field_date')->value : NULL;
  $end = $start ? (int) ($node->get('field_date')->end_value ?: $start) : NULL;
  $date = $start ? _club_date_parts($start) : [];
  $end_parts = $end ? _club_date_parts($end) : [];
  $multi_day = $start && date('Ymd', $start) !== date('Ymd', max($start, $end - 60));

  // Naše zápasy po fázích (paragraphs Zápas na turnaji).
  $phases = [];
  $record = ['V' => 0, 'R' => 0, 'P' => 0, 'gf' => 0, 'ga' => 0];
  if ($node->hasField('field_tournament_games')) {
    foreach ($node->get('field_tournament_games')->referencedEntities() as $game) {
      $cache->addCacheableDependency($game);
      $opponent = _club_ref($game, 'field_opponent');
      if ($opponent) {
        $cache->addCacheableDependency($opponent);
      }
      $us = _club_value($game, 'field_score_us');
      $them = _club_value($game, 'field_score_them');
      $penalties = _club_value($game, 'field_penalties');
      $result = NULL;
      if ($us !== NULL && $them !== NULL) {
        $result = [1 => 'V', 0 => 'R', -1 => 'P'][(int) $us <=> (int) $them];
        // Remíza rozhodnutá penaltami („4:3 pen.“).
        if ($result === 'R' && $penalties && preg_match('/(\d+)\s*:\s*(\d+)/', $penalties, $m)) {
          $result = (int) $m[1] > (int) $m[2] ? 'V' : 'P';
        }
        $record[$result]++;
        $record['gf'] += (int) $us;
        $record['ga'] += (int) $them;
      }
      $phase = _club_value($game, 'field_phase') ?? '';
      $phases[$phase] ??= ['label' => $phase, 'games' => []];
      $phases[$phase]['games'][] = [
        'opponent' => $opponent?->label() ?? '',
        'us' => $us,
        'them' => $them,
        'penalties' => $penalties,
        'scorers' => _club_value($game, 'field_scorers'),
        'result' => $result,
      ];
    }
  }

  // Přílohy (propozice, rozpis).
  $attachments = [];
  if ($node->hasField('field_attachments')) {
    foreach ($node->get('field_attachments') as $item) {
      if ($file = $item->entity) {
        $attachments[] = [
          'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
          'name' => $item->description ?: $file->getFilename(),
          'size' => (string) \Drupal\Core\StringTranslation\ByteSizeMarkup::create((int) $file->getSize()),
        ];
      }
    }
  }

  // Fotky.
  $images = [];
  if ($node->hasField('field_images')) {
    foreach ($node->get('field_images') as $item) {
      if ($file = $item->entity) {
        $images[] = [
          'thumb' => _club_file_image_url($file, 'club_card'),
          'full' => _club_file_image_url($file, 'club_wide') ?? _club_file_image_url($file),
          'alt' => (string) ($item->alt ?? ''),
        ];
      }
    }
  }

  $link = NULL;
  if ($node->hasField('field_link') && !$node->get('field_link')->isEmpty()) {
    $item = $node->get('field_link')->first();
    $link = ['url' => $item->getUrl()->toString(), 'title' => $item->title ?: 'Výsledky pořadatele'];
  }

  $teams = [];
  foreach ($node->hasField('field_team') ? $node->get('field_team')->referencedEntities() : [] as $team) {
    $cache->addCacheableDependency($team);
    $teams[] = [
      'label' => _club_value($team, 'field_short_title') ?? $team->label(),
      'merged' => (bool) _club_ref($team, 'field_partner_club'),
      'club' => _club_is_club($team),
    ];
  }

  $venue = _club_ref($node, 'field_venue')?->label();
  $past = $end !== NULL && $end < $now;
  if ($start && !$past) {
    $cache->setCacheMaxAge(max(60, min(3600, $end - $now)));
  }

  return [
    'date' => $date,
    'range' => $multi_day ? $date['day_month'] . ' – ' . $end_parts['day_month'] : NULL,
    'time' => $date['time'] ?? NULL,
    'past' => $past,
    'venue' => $venue,
    'organizer' => _club_ref($node, 'field_organizer')?->label(),
    'format' => _club_value($node, 'field_format'),
    'placement' => _club_value($node, 'field_placement'),
    'phases' => array_values($phases),
    'record' => array_sum(array_slice($record, 0, 3)) ? $record : NULL,
    'teams' => $teams,
    'link' => $link,
    'attachments' => $attachments,
    'images' => $images,
    'calendar' => $past ? [] : _club_calendar_links($node, $start, $end, $venue),
  ];
}

/**
 * Odkazy „Přidat do kalendáře“ pro jednu událost (.ics ze club_core + Google).
 */
function _club_calendar_links(NodeInterface $node, ?int $start, ?int $end, ?string $location): array {
  if (!$start) {
    return [];
  }
  $end = $end ?: $start;
  $start_time = _club_date_parts($start)['time'];
  $end_time = _club_date_parts($end)['time'];
  $all_day = $start_time === NULL && in_array($end_time, [NULL, '23:59'], TRUE);
  $links = [];
  try {
    $links['ics'] = Url::fromRoute('club_core.ics_node', ['node' => $node->id()])->toString();
  }
  catch (\Exception) {
  }
  $links['google'] = 'https://calendar.google.com/calendar/render?' . http_build_query([
    'action' => 'TEMPLATE',
    'text' => $node->label(),
    'dates' => $all_day
      ? date('Ymd', $start) . '/' . date('Ymd', strtotime('+1 day', max($start, $end - 1)))
      : gmdate('Ymd\THis\Z', $start) . '/' . gmdate('Ymd\THis\Z', $end),
    'location' => (string) $location,
    'details' => $node->toUrl('canonical', ['absolute' => TRUE])->toString(),
  ]);
  return $links;
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy-term--competition.
 *
 * Stránka soutěže: tabulka, rozpis a výsledky zápasů v soutěži.
 */
function club_preprocess_taxonomy_term__competition(array &$variables): void {
  $term = $variables['term'];
  $cache = CacheableMetadata::createFromRenderArray($variables)->addCacheTags(['node_list:match'])->setCacheMaxAge(3600);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $now = \Drupal::time()->getRequestTime();

  $ids = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'match')
    ->condition('status', 1)
    ->condition('field_competition', $term->id())
    ->sort('field_date.value', 'ASC')
    ->execute();

  $upcoming = [];
  $played = [];
  foreach ($storage->loadMultiple($ids) as $match) {
    $status = _club_value($match, 'field_match_status');
    $end = $match->hasField('field_date') ? (int) ($match->get('field_date')->end_value ?: $match->get('field_date')->value) : 0;
    if ($status === 'played') {
      $played[] = $view_builder->view($match, 'row');
    }
    elseif ($end >= $now && $status !== 'cancelled') {
      $upcoming[] = $view_builder->view($match, 'agenda');
    }
  }

  $link = NULL;
  if ($term->hasField('field_link') && !$term->get('field_link')->isEmpty()) {
    $item = $term->get('field_link')->first();
    $link = ['url' => $item->getUrl()->toString(), 'title' => $item->title ?: 'Oficiální výsledky'];
  }
  $attachments = [];
  if ($term->hasField('field_attachments')) {
    foreach ($term->get('field_attachments') as $item) {
      if ($file = $item->entity) {
        $attachments[] = [
          'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
          'name' => $item->description ?: $file->getFilename(),
          'size' => (string) \Drupal\Core\StringTranslation\ByteSizeMarkup::create((int) $file->getSize()),
        ];
      }
    }
  }
  $updated = _club_timestamp($term, 'field_standings_updated');

  $variables['club'] = [
    'upcoming' => $upcoming,
    'played' => array_reverse($played),
    'link' => $link,
    'attachments' => $attachments,
    'updated' => $updated ? _club_date_parts($updated)['long'] : NULL,
  ];
  $cache->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for node--player.
 *
 * Číslo a post se později budou brát z roster_entry (soupiska v sezóně).
 * Do té doby šablona použije pole field_number / field_position, pokud existují.
 */
function club_preprocess_node__player(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $home_club = _club_ref($node, 'field_home_club');
  if ($home_club) {
    $cache->addCacheableDependency($home_club);
  }

  if ($variables['view_mode'] === 'full') {
    $variables['player'] = _club_player_detail($node, $cache);
  }

  $last = _club_value($node, 'field_last_name');
  $variables['club'] = [
    'first_name' => _club_value($node, 'field_first_name') ?? '',
    'last_name' => $last ?? $node->label(),
    'number' => _club_value($node, 'field_number'),
    'position' => _club_list_label($node, 'field_position'),
    // Fotka jen se souhlasem (u mládeže souhlas zákonného zástupce).
    'photo_url' => (!$node->hasField('field_photo_consent') || _club_value($node, 'field_photo_consent'))
      ? _club_image_url(_club_ref($node, 'field_photo'), 'club_player')
      : NULL,
    // Prázdný mateřský klub = náš klub (název z nastavení tématu).
    'partner' => (bool) $home_club,
    'partner_label' => $home_club?->label(),
  ];
  $cache->applyTo($variables);
}

/**
 * Detail hráče: týmy, statistiky po sezónách, poslední zápasy, spoluhráči.
 *
 * Statistiky se počítají ze zápasů ve stavu Odehráno: start = základní
 * sestava, zápas = sestava nebo náhradníci, góly / asistence / karty
 * z událostí zápasu (paragraphs Událost zápasu).
 */
function _club_player_detail(NodeInterface $player, CacheableMetadata $cache): array {
  $cache->addCacheTags(['node_list:match', 'node_list:player']);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $pid = (int) $player->id();

  // Týmy hráče s odkazem na stránku O týmu.
  $teams = [];
  foreach ($player->hasField('field_team') ? $player->get('field_team')->referencedEntities() : [] as $team) {
    $cache->addCacheableDependency($team);
    try {
      $url = Url::fromRoute('club_core.team_detail', ['node' => _club_value($team, 'field_slug') ?? $team->id()])->toString();
    }
    catch (\Exception) {
      $url = $team->toUrl()->toString();
    }
    $teams[] = ['label' => $team->label(), 'url' => $url, 'merged' => (bool) _club_ref($team, 'field_partner_club')];
  }

  // Zápasy, kde hráč nastoupil nebo má událost.
  $ids = [];
  $definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('node');
  $query = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'match')->condition('status', 1);
  $or = $query->orConditionGroup();
  foreach (['field_lineup', 'field_substitutes'] as $field) {
    if (isset($definitions[$field])) {
      $or->condition($field, $pid);
    }
  }
  if ($or->count()) {
    $ids = $query->condition($or)->execute();
  }
  if (\Drupal::entityTypeManager()->hasDefinition('paragraph')) {
    $paragraph_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('paragraph');
    $pquery = \Drupal::entityTypeManager()->getStorage('paragraph')->getQuery()->accessCheck(FALSE)
      ->condition('type', 'match_event')
      ->condition('parent_type', 'node');
    $por = $pquery->orConditionGroup();
    foreach (['field_player', 'field_assist'] as $field) {
      if (isset($paragraph_definitions[$field])) {
        $por->condition($field, $pid);
      }
    }
    if ($por->count()) {
      foreach (\Drupal::entityTypeManager()->getStorage('paragraph')->loadMultiple($pquery->condition($por)->execute()) as $paragraph) {
        $ids[] = (int) $paragraph->get('parent_id')->value;
      }
    }
  }

  $seasons = [];
  $matches = [];
  foreach ($storage->loadMultiple(array_unique($ids)) as $match) {
    if ($match->bundle() !== 'match' || !$match->isPublished() || _club_value($match, 'field_match_status') !== 'played') {
      continue;
    }
    $cache->addCacheableDependency($match);
    $in_lineup = $match->hasField('field_lineup') && in_array($pid, array_map('intval', array_column($match->get('field_lineup')->getValue(), 'target_id')), TRUE);
    $in_subs = $match->hasField('field_substitutes') && in_array($pid, array_map('intval', array_column($match->get('field_substitutes')->getValue(), 'target_id')), TRUE);

    $line = ['goals' => 0, 'assists' => 0, 'yellow' => 0, 'red' => 0];
    if ($match->hasField('field_match_events')) {
      foreach ($match->get('field_match_events')->referencedEntities() as $event) {
        if (_club_value($event, 'field_is_opponent')) {
          continue;
        }
        $type = _club_value($event, 'field_event_type');
        $is_player = (int) ($event->hasField('field_player') ? $event->get('field_player')->target_id : 0) === $pid;
        $is_assist = (int) ($event->hasField('field_assist') ? $event->get('field_assist')->target_id : 0) === $pid;
        if ($is_player && in_array($type, ['goal', 'penalty'], TRUE)) {
          $line['goals']++;
        }
        if ($is_assist) {
          $line['assists']++;
        }
        if ($is_player && in_array($type, ['yellow', 'second_yellow'], TRUE)) {
          $line['yellow']++;
        }
        if ($is_player && in_array($type, ['red', 'second_yellow'], TRUE)) {
          $line['red']++;
        }
      }
    }
    $played = $in_lineup || $in_subs || array_sum($line) > 0;
    if (!$played) {
      continue;
    }

    $season = _club_ref($match, 'field_season')?->label() ?? '–';
    $seasons[$season] ??= ['season' => $season, 'apps' => 0, 'starts' => 0, 'goals' => 0, 'assists' => 0, 'yellow' => 0, 'red' => 0];
    $seasons[$season]['apps']++;
    $seasons[$season]['starts'] += $in_lineup ? 1 : 0;
    foreach ($line as $key => $value) {
      $seasons[$season][$key] += $value;
    }

    // Řádek do „Posledních zápasů“.
    $is_home = _club_value($match, 'field_is_home');
    $is_home = $is_home === NULL || (bool) $is_home;
    $us = (int) _club_value($match, 'field_score_us');
    $them = (int) _club_value($match, 'field_score_them');
    $timestamp = _club_timestamp($match, 'field_date') ?? 0;
    $matches[] = [
      'timestamp' => $timestamp,
      'url' => $match->toUrl()->toString(),
      'date' => $timestamp ? _club_date_parts($timestamp)['day_month'] : '',
      'opponent' => _club_ref($match, 'field_opponent')?->label(),
      'is_home' => $is_home,
      'score' => $is_home ? $us . ':' . $them : $them . ':' . $us,
      'result' => [1 => 'V', 0 => 'R', -1 => 'P'][$us <=> $them],
      'started' => $in_lineup,
    ] + $line;
  }

  krsort($seasons, SORT_NATURAL);
  usort($matches, static fn($a, $b) => $b['timestamp'] <=> $a['timestamp']);

  // Spoluhráči z prvního týmu.
  $mates = [];
  $first_team = $player->hasField('field_team') ? $player->get('field_team')->target_id : NULL;
  if ($first_team) {
    $mate_ids = $storage->getQuery()->accessCheck(TRUE)
      ->condition('type', 'player')
      ->condition('status', 1)
      ->condition('field_team', $first_team)
      ->condition('nid', $pid, '<>')
      ->sort('field_number', 'ASC')
      ->range(0, 30)
      ->execute();
    if ($mate_ids) {
      $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
      foreach ($storage->loadMultiple($mate_ids) as $mate) {
        $mates[] = $view_builder->view($mate, 'teaser');
      }
    }
  }

  return [
    'teams' => $teams,
    'birth_year' => _club_value($player, 'field_birth_year'),
    'seasons' => array_values($seasons),
    'current' => $seasons ? reset($seasons) : NULL,
    'matches' => array_slice($matches, 0, 6),
    'mates' => $mates,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for node--event.
 */
function club_preprocess_node__event(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $timestamp = _club_timestamp($node, 'field_date');
  $variables['club'] = _club_team_info(_club_ref($node, 'field_team'), $cache) + [
    'date' => $timestamp ? _club_date_parts($timestamp) : [],
    'note' => _club_value($node, 'field_location'),
  ];
  if ($variables['view_mode'] === 'full') {
    $variables['event'] = _club_event_detail($node, $cache);
  }
  $cache->applyTo($variables);
}

/**
 * Detail akce: termín, místo, odkazy do kalendáře, další akce a zápasy.
 */
function _club_event_detail(NodeInterface $node, CacheableMetadata $cache): array {
  $now = \Drupal::time()->getRequestTime();
  $start = $node->hasField('field_date') && !$node->get('field_date')->isEmpty() ? (int) $node->get('field_date')->value : NULL;
  $end = $start ? (int) ($node->get('field_date')->end_value ?: $start) : NULL;

  $date = [];
  $time = NULL;
  $all_day = FALSE;
  $range = NULL;
  if ($start) {
    $date = _club_date_parts($start);
    $end_parts = _club_date_parts($end);
    $all_day = $date['time'] === NULL && in_array($end_parts['time'], [NULL, '23:59'], TRUE);
    $same_day = $date['iso'] && date('Ymd', $start) === date('Ymd', $all_day && $end_parts['time'] === NULL ? $end - 1 : $end);
    if (!$same_day) {
      $range = $date['day_month'] . ' – ' . $end_parts['day_month'];
    }
    if (!$all_day) {
      $time = $date['time'] . ($end_parts['time'] && $end_parts['time'] !== $date['time'] ? '–' . $end_parts['time'] : '');
    }
    // Stav „Proběhlo“ se mění s časem.
    $cache->setCacheMaxAge(max(60, min(3600, ($end > $now ? $end - $now : 3600))));
  }

  // Týmy akce (štítky) a filtr pro další akce.
  $teams = [];
  $team_ids = [];
  $club_only = TRUE;
  foreach ($node->hasField('field_team') ? $node->get('field_team')->referencedEntities() : [] as $team) {
    $cache->addCacheableDependency($team);
    $is_club = _club_is_club($team);
    $club_only = $club_only && $is_club;
    $team_ids[] = $team->id();
    $teams[] = [
      'label' => $is_club ? 'Klub' : (_club_value($team, 'field_short_title') ?? $team->label()),
      'merged' => (bool) _club_ref($team, 'field_partner_club'),
      'club' => $is_club,
    ];
  }

  $location = _club_value($node, 'field_location');
  $title = $node->label();

  // Odkazy do kalendáře.
  $ics_url = NULL;
  try {
    $ics_url = Url::fromRoute('club_core.ics_node', ['node' => $node->id()])->toString();
  }
  catch (\Exception) {
  }
  $google_url = NULL;
  if ($start) {
    $dates = $all_day
      ? date('Ymd', $start) . '/' . date('Ymd', strtotime('+1 day', $end - 1))
      : gmdate('Ymd\THis\Z', $start) . '/' . gmdate('Ymd\THis\Z', $end);
    $google_url = 'https://calendar.google.com/calendar/render?' . http_build_query([
      'action' => 'TEMPLATE',
      'text' => $title,
      'dates' => $dates,
      'location' => (string) $location,
      'details' => $node->toUrl('canonical', ['absolute' => TRUE])->toString(),
    ]);
  }

  // Další akce: stejné týmy + klubové (u klubové akce všechny).
  $cache->addCacheTags(['node_list:event', 'node_list:match']);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
  $club = \Drupal::hasService('club_core.team_context') ? \Drupal::service('club_core.team_context')->getClub() : NULL;

  $query = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'event')
    ->condition('status', 1)
    ->condition('nid', $node->id(), '<>')
    ->condition('field_date.end_value', $now, '>=')
    ->sort('field_date.value', 'ASC')
    ->range(0, 4);
  if (!$club_only && $team_ids) {
    $query->condition('field_team', array_merge($team_ids, $club ? [$club->id()] : []), 'IN');
  }
  $others = [];
  foreach ($storage->loadMultiple($query->execute()) as $other) {
    $others[] = $view_builder->view($other, 'teaser');
  }

  // Nejbližší zápasy týmů akce (u klubové akce všech týmů).
  $match_query = $storage->getQuery()->accessCheck(TRUE)
    ->condition('type', 'match')
    ->condition('status', 1)
    ->condition('field_date.end_value', $now, '>=')
    ->sort('field_date.value', 'ASC')
    ->range(0, 3);
  if (!$club_only && $team_ids) {
    $match_query->condition('field_team', $team_ids, 'IN');
  }
  $matches = [];
  foreach ($storage->loadMultiple($match_query->execute()) as $match) {
    $matches[] = $view_builder->view($match, 'agenda');
  }

  return [
    'date' => $date,
    'time' => $time,
    'all_day' => $all_day,
    'range' => $range,
    'past' => $end !== NULL && $end < $now,
    'location' => $location,
    'map_url' => $location ? 'https://mapy.cz/zakladni?q=' . rawurlencode($location) : NULL,
    'teams' => $teams,
    'ics_url' => $ics_url,
    'google_url' => $google_url,
    'image' => _club_article_images($node)[1] ?? NULL,
    'others' => $others,
    'matches' => $matches,
  ];
}

/* ------------------------------------------------------------------------
 * Video (node typu video – odkaz na VEO nebo vlastní soubor na serveru)
 * --------------------------------------------------------------------- */

/**
 * Implements hook_preprocess_HOOK() for node--video.
 *
 * Přímý soubor (.mp4, .webm, .m4v) se přehraje na detailu videa na webu,
 * ostatní odkazy (VEO) se otevírají na stránce poskytovatele.
 */
function club_preprocess_node__video(array &$variables): void {
  $node = $variables['node'];
  $cache = CacheableMetadata::createFromRenderArray($variables);

  $video_url = NULL;
  if ($node->hasField('field_video_url') && !$node->get('field_video_url')->isEmpty()) {
    $video_url = $node->get('field_video_url')->first()->getUrl()->toString();
  }
  $playable = $video_url && preg_match('/\.(mp4|webm|m4v)(\?|#|$)/i', $video_url);
  $host = $video_url ? (string) parse_url($video_url, PHP_URL_HOST) : '';
  $source_label = match (TRUE) {
    !$video_url || $playable => NULL,
    str_contains($host, 'veo.co') => 'VEO',
    str_contains($host, 'youtu') => 'YouTube',
    default => preg_replace('/^www\./', '', $host),
  };

  $category = _club_ref($node, 'field_video_category');
  $match = _club_ref($node, 'field_match');
  foreach ([$category, $match] as $entity) {
    if ($entity) {
      $cache->addCacheableDependency($entity);
    }
  }
  $team = _club_team_info(_club_ref($node, 'field_team'), $cache);

  $variables['club'] = [
    // Karta vede u vlastních souborů na detail (přehrávač), jinak rovnou na VEO.
    'url' => $playable || !$video_url ? $variables['url'] : $video_url,
    'external' => $video_url && !$playable,
    'source_label' => $source_label,
    'title' => $node->label(),
    'thumbnail_url' => _club_file_image_url(_club_ref($node, 'field_thumbnail'), 'club_video'),
    'duration' => _club_value($node, 'field_duration'),
    'category' => $category?->label(),
    'date' => _club_date_parts((int) $node->getCreatedTime())['short'],
    'team_label' => $team['team_label'],
    'team_merged' => $team['team_merged'],
    'show_team' => $team['show_team'],
  ];
  // Odkaz na rozbor v aplikaci MVR (jen u vlastních souborů, pokud je MVR nastavené).
  $mvr_base = rtrim((string) \Drupal\Core\Site\Settings::get('club_mvr_base_url', ''), '/');
  $variables['club_detail'] = [
    'mvr_url' => ($mvr_base && $playable) ? $mvr_base . '/ref/' . rawurlencode('club:node:' . $node->id()) : NULL,
    'video_url' => $video_url,
    'playable' => (bool) $playable,
    'match_url' => $match?->toUrl()->toString(),
    'match_label' => $match?->label(),
    'date_long' => _club_date_parts((int) $node->getCreatedTime())['long'],
  ];
  $cache->applyTo($variables);
}

/* ------------------------------------------------------------------------
 * Pomocné funkce
 * --------------------------------------------------------------------- */

/**
 * Hodnota prvního položky pole, nebo NULL.
 */
function _club_value(?FieldableEntityInterface $entity, string $field): ?string {
  if (!$entity || !$entity->hasField($field) || $entity->get($field)->isEmpty()) {
    return NULL;
  }
  $value = $entity->get($field)->value;
  return $value === NULL ? NULL : (string) $value;
}

/**
 * Odkazovaná entita z prvního položky pole, nebo NULL.
 */
function _club_ref(?FieldableEntityInterface $entity, string $field): ?FieldableEntityInterface {
  if (!$entity || !$entity->hasField($field) || $entity->get($field)->isEmpty()) {
    return NULL;
  }
  $target = $entity->get($field)->entity;
  return $target instanceof FieldableEntityInterface ? $target : NULL;
}

/**
 * Popisek hodnoty list pole (goalkeeper → Brankář).
 */
function _club_list_label(FieldableEntityInterface $entity, string $field): ?string {
  $value = _club_value($entity, $field);
  if ($value === NULL) {
    return NULL;
  }
  $allowed = $entity->get($field)->getFieldDefinition()->getFieldStorageDefinition()->getSetting('allowed_values') ?? [];
  return isset($allowed[$value]) ? (string) $allowed[$value] : $value;
}

/**
 * Unix timestamp z pole typu datetime, daterange, smartdate nebo timestamp.
 */
function _club_timestamp(FieldableEntityInterface $entity, string $field): ?int {
  // Když pole field_date neexistuje (jiný machine name), vezme se první
  // datumové pole entity.
  if (!$entity->hasField($field)) {
    $field = NULL;
    foreach ($entity->getFieldDefinitions() as $name => $definition) {
      if (str_starts_with($name, 'field_') && in_array($definition->getType(), ['smartdate', 'daterange', 'datetime'], TRUE)) {
        $field = $name;
        break;
      }
    }
    if (!$field) {
      return NULL;
    }
  }
  if ($entity->get($field)->isEmpty()) {
    return NULL;
  }
  $items = $entity->get($field);
  $type = $items->getFieldDefinition()->getType();
  $value = $items->value;
  if (in_array($type, ['smartdate', 'timestamp', 'created', 'changed'], TRUE) || is_numeric($value)) {
    return (int) $value;
  }
  $property = $items->first()?->get('value');
  if ($property && method_exists($property, 'getDateTime')) {
    return $property->getDateTime()?->getTimestamp();
  }
  $time = strtotime((string) $value . ' UTC');
  return $time === FALSE ? NULL : $time;
}

/**
 * České části data pro šablony (v časové zóně webu).
 */
function _club_date_parts(int $timestamp): array {
  $days = ['ne', 'po', 'út', 'st', 'čt', 'pá', 'so'];
  $days_long = ['neděle', 'pondělí', 'úterý', 'středa', 'čtvrtek', 'pátek', 'sobota'];
  $months = ['ledna', 'února', 'března', 'dubna', 'května', 'června', 'července', 'srpna', 'září', 'října', 'listopadu', 'prosince'];
  $months_short = ['led', 'úno', 'bře', 'dub', 'kvě', 'čvn', 'čvc', 'srp', 'zář', 'říj', 'lis', 'pro'];

  $months_nominative = ['leden', 'únor', 'březen', 'duben', 'květen', 'červen', 'červenec', 'srpen', 'září', 'říjen', 'listopad', 'prosinec'];

  [$w, $j, $n, $time, $year] = explode('|', \Drupal::service('date.formatter')->format($timestamp, 'custom', 'w|j|n|H:i|Y'));
  return [
    'short' => sprintf('%s %d. %d.', $days[$w], $j, $n),
    'long' => sprintf('%s %d. %s', $days_long[$w], $j, $months[$n - 1]),
    'day' => (int) $j,
    'month_short' => $months_short[$n - 1],
    'time' => $time === '00:00' ? NULL : $time,
    'weekday' => $days[$w],
    'day_month' => sprintf('%d. %d.', $j, $n),
    'month_year' => $months_nominative[$n - 1] . ' ' . $year,
    'iso' => date('c', $timestamp),
  ];
}

/**
 * „Dnes“, „Zítra“, „Za 3 dny“ – podle kalendářních dnů.
 */
function _club_relative_day(int $timestamp): ?string {
  $today = new \DateTimeImmutable('today');
  $day = (new \DateTimeImmutable('@' . $timestamp))->setTimezone($today->getTimezone())->setTime(0, 0);
  $diff = (int) $today->diff($day)->format('%r%a');
  return match (TRUE) {
    $diff < 0 => NULL,
    $diff === 0 => 'Dnes',
    $diff === 1 => 'Zítra',
    $diff < 5 => sprintf('Za %d dny', $diff),
    default => sprintf('Za %d dní', $diff),
  };
}

/**
 * Údaje o týmu pro štítek; štítek se ukazuje jen v kontextu „Celý klub“.
 */
function _club_team_info(?FieldableEntityInterface $team, CacheableMetadata $cache): array {
  if ($team) {
    $cache->addCacheableDependency($team);
  }
  $show = TRUE;
  if (\Drupal::hasService('club_core.team_context')) {
    $cache->addCacheContexts(['team']);
    $show = \Drupal::service('club_core.team_context')->getTeam() === NULL;
  }
  $is_club = !$team || _club_is_club($team);
  return [
    'team_label' => $is_club ? 'Klub' : (_club_value($team, 'field_short_title') ?? $team->label()),
    'team_merged' => !$is_club && (bool) _club_ref($team, 'field_partner_club'),
    'team_is_club' => $is_club,
    'show_team' => $show,
  ];
}

function _club_is_club(FieldableEntityInterface $team): bool {
  return (bool) _club_value($team, 'field_is_club');
}

/**
 * Iniciály klubu bez prefixů SK/FK/TJ/Sokol („Sokol Pchery“ → „PC“).
 */
function _club_initials(string $name): string {
  $words = array_values(array_filter(
    preg_split('/\s+/u', trim($name)) ?: [],
    fn ($w) => $w !== '' && !in_array(mb_strtoupper($w), ['SK', 'FK', 'TJ', 'SOKOL', 'AFK', 'SFK'], TRUE),
  ));
  if (!$words) {
    return '';
  }
  $initials = count($words) > 1
    ? mb_substr($words[0], 0, 1) . mb_substr($words[1], 0, 1)
    : mb_substr($words[0], 0, 2);
  return mb_strtoupper($initials);
}

/**
 * URL obrázku z media entity typu Obrázek (volitelně přes styl obrázku).
 */
function _club_image_url(?FieldableEntityInterface $media, ?string $style = NULL): ?string {
  if (!$media instanceof MediaInterface) {
    return NULL;
  }
  $field = $media->getSource()->getConfiguration()['source_field'] ?? NULL;
  $file = $field ? _club_ref($media, $field) : NULL;
  if (!$file) {
    return NULL;
  }
  $uri = $file->getFileUri();
  if ($style && ($image_style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style))) {
    return \Drupal::service('file_url_generator')->transformRelative($image_style->buildUrl($uri));
  }
  return \Drupal::service('file_url_generator')->generateString($uri);
}

/**
 * URL obrázku z pole typu Obrázek (file entita), volitelně přes styl.
 */
function _club_file_image_url(?FieldableEntityInterface $file, ?string $style = NULL): ?string {
  if (!$file || !method_exists($file, 'getFileUri')) {
    return NULL;
  }
  $uri = $file->getFileUri();
  if ($style && ($image_style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style))) {
    return \Drupal::service('file_url_generator')->transformRelative($image_style->buildUrl($uri));
  }
  return \Drupal::service('file_url_generator')->generateString($uri);
}

/**
 * Převede /cesta nebo https://… na URL řetězec.
 */
function _club_url_string(string $value): ?string {
  $value = trim($value);
  if ($value === '') {
    return NULL;
  }
  try {
    $url = str_starts_with($value, '/') || str_starts_with($value, '?') || str_starts_with($value, '#')
      ? Url::fromUserInput($value)
      : Url::fromUri($value);
    return $url->toString();
  }
  catch (\InvalidArgumentException) {
    return NULL;
  }
}
