{% if content %}
  <section{{ attributes.addClass('mx-auto', 'max-w-7xl', 'px-4', 'sm:px-6', 'py-12', 'sm:py-16', 'grid', 'lg:grid-cols-[1.5fr_1fr]', 'gap-10', 'lg:gap-12') }}>
    <div{{ region_attributes.first.addClass('space-y-12', 'min-w-0') }}>{{ content.first }}</div>
    <div{{ region_attributes.second.addClass('space-y-8', 'min-w-0') }}>{{ content.second }}</div>
  </section>
{% endif %}
