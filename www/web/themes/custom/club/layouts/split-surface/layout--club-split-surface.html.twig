{% if content %}
  <section{{ attributes.addClass('bg-surface', 'border-y', 'border-line') }}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 sm:py-16 grid lg:grid-cols-[1.6fr_1fr] gap-6 lg:gap-8">
      <div{{ region_attributes.first.addClass('space-y-8', 'min-w-0') }}>{{ content.first }}</div>
      <div{{ region_attributes.second.addClass('space-y-8', 'min-w-0', 'lg:pt-[3.75rem]') }}>{{ content.second }}</div>
    </div>
  </section>
{% endif %}
