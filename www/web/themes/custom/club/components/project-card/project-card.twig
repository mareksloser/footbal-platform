<article class="group relative h-full flex flex-col">
  <div class="relative aspect-[16/10] rounded-xl overflow-hidden bg-surface">
    {% if image_url %}
      <img src="{{ image_url }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]">
    {% elseif logo_url %}
      <div class="absolute inset-0 grid place-items-center">
        <img src="{{ logo_url }}" alt="" class="h-16 w-auto opacity-20 grayscale">
      </div>
    {% endif %}
    <span class="absolute left-3 top-3">{{ include('club:project-status', {status: status, label: status_label, solid: true}, with_context = false) }}</span>
  </div>
  <div class="min-w-0 mt-4">
    {% if term %}<p class="text-sm text-muted">{{ term }}</p>{% endif %}
    <h3 class="cond text-2xl font-bold leading-tight mt-1 text-balance">
      <a href="{{ url }}" class="group-hover:text-redink after:absolute after:inset-0">{{ title }}</a>
    </h3>
    {% if lead %}<p class="text-muted mt-2 line-clamp-3">{{ lead }}</p>{% endif %}
    {% if progress is not null and status == 'running' %}
      <div class="mt-4 flex items-center gap-3 text-sm">
        <div class="h-1.5 flex-1 rounded-full bg-line overflow-hidden" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100" aria-label="Postup projektu">
          <div class="h-full rounded-full bg-red" style="width: {{ progress }}%"></div>
        </div>
        <span class="font-semibold tnum">{{ progress }} %</span>
      </div>
    {% endif %}
  </div>
</article>
