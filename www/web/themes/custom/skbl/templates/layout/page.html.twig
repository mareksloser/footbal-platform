{#
/**
 * @file
 * Stránka – lišta akcí, hlavička s logem uprostřed, přepínač týmů, obsah, patička.
 *
 * Proměnné z skbl_preprocess_page():
 * - logo_url, site_name, cta_label, cta_label_mobile, cta_url,
 *   club_name, club_address, club_email, footer_note, is_team_page, year.
 */
#}
<div class="min-h-screen flex flex-col">

  {% if page.ticker %}
    <div class="bg-red text-white" data-skbl-ticker>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 h-10 flex items-center gap-3 text-sm">
        <span class="font-semibold shrink-0 max-sm:hidden">Nejbližší akce</span>
        <span class="h-4 w-px bg-white/40 max-sm:hidden" aria-hidden="true"></span>
        <div class="flex-1 min-w-0 skbl-ticker" aria-live="polite">{{ page.ticker }}</div>
        <div class="flex items-center gap-1 shrink-0" data-ticker-controls hidden>
          <button type="button" data-ticker-prev class="h-7 w-7 grid place-items-center rounded hover:bg-white/15" aria-label="Předchozí akce">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <span data-ticker-count class="tnum text-xs text-white/80 w-9 text-center"></span>
          <button type="button" data-ticker-next class="h-7 w-7 grid place-items-center rounded hover:bg-white/15" aria-label="Další akce">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  {% endif %}

  <header class="sticky top-[var(--drupal-displace-offset-top,0px)] z-50 bg-bg/95 backdrop-blur border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 h-20 grid grid-cols-[1fr_auto_1fr] items-center">
      <div class="flex max-lg:hidden items-center min-w-0">{{ page.header_left }}</div>

      <button type="button" class="lg:hidden justify-self-start h-10 w-10 grid place-items-center rounded-md hover:bg-surface"
              data-skbl-menu-toggle aria-controls="skbl-mobile-menu" aria-expanded="false" aria-label="Otevřít menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <a href="{{ path('<front>') }}" class="justify-self-center flex items-center" rel="home" aria-label="{{ site_name }} – úvod">
        <img src="{{ logo_url }}" alt="Znak {{ site_name }}" class="h-16 w-auto" width="240" height="288">
      </a>

      <div class="flex max-lg:hidden items-center justify-end gap-1 min-w-0">
        {{ page.header_right }}
        {% if cta_url and cta_label %}
          <a href="{{ cta_url }}" class="ml-2 px-4 py-2 rounded-md bg-ink text-bg font-semibold hover:opacity-90 whitespace-nowrap">{{ cta_label }}</a>
        {% endif %}
      </div>
      {% if cta_url and cta_label_mobile %}
        <a href="{{ cta_url }}" class="lg:hidden justify-self-end text-sm font-semibold px-3 py-2 rounded-md bg-ink text-bg">{{ cta_label_mobile }}</a>
      {% else %}
        <span class="lg:hidden"></span>
      {% endif %}
    </div>

    <div id="skbl-mobile-menu" class="skbl-mobile-nav lg:hidden hidden border-t border-line bg-bg max-h-[70vh] overflow-y-auto">
      <div class="px-4 py-3 text-[15px]">
        {{ page.header_left }}
        {{ page.header_right }}
      </div>
    </div>

    {% if page.switcher %}
      <div class="border-t border-line bg-bg">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 flex items-center gap-3 h-14">
          <span class="text-sm text-muted shrink-0 max-md:hidden">Zobrazit obsah pro</span>
          <div class="min-w-0 flex-1 skbl-fade-x">{{ page.switcher }}</div>
        </div>
      </div>
    {% endif %}
  </header>

  {% if page.highlighted %}
    <div class="mx-auto max-w-7xl w-full px-4 sm:px-6 pt-6">{{ page.highlighted }}</div>
  {% endif %}

  {% if page.page_header and not hide_page_header %}
    <div class="bg-surface border-b border-line relative overflow-hidden">
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-red"></div>
      <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12 space-y-5">{{ page.page_header }}</div>
    </div>
  {% endif %}

  <main id="main-content" tabindex="-1" class="flex-1 focus:outline-none">
    {{ page.content }}
  </main>

  <footer class="bg-ink text-bg mt-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid gap-10 md:grid-cols-[auto_1fr] lg:grid-cols-[auto_16rem_1fr]">
      <img src="{{ logo_url }}" alt="" class="h-20 w-auto">
      <div>
        {% if club_name %}<p class="cond text-xl font-bold">{{ club_name }}</p>{% endif %}
        {% if club_address %}<p class="mt-2 text-bg/70 text-sm leading-relaxed">{{ club_address|nl2br }}</p>{% endif %}
        {% if club_email %}<a href="mailto:{{ club_email }}" class="mt-1 inline-block text-sm text-bg/70 hover:text-bg">{{ club_email }}</a>{% endif %}
      </div>
      {% if page.footer %}
        <div class="skbl-footer grid gap-8 sm:grid-cols-2 lg:grid-cols-3 md:col-span-2 lg:col-span-1">{{ page.footer }}</div>
      {% endif %}
    </div>
    <div class="border-t border-bg/10">
      <p class="mx-auto max-w-7xl px-4 sm:px-6 py-5 text-xs text-bg/50">© {{ year }} {{ site_name }}.{% if footer_note %} {{ footer_note }}{% endif %}</p>
    </div>
  </footer>
</div>
