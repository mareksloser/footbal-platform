{# Loga partnerů ze slovníku Partner, řazená podle váhy. #}
<section{{ attributes }}>
  {% if skbl.title %}<h2 class="cond text-3xl font-bold mb-5">{{ skbl.title }}</h2>{% endif %}
  {% if skbl.partners %}
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-line border border-line rounded-xl overflow-hidden">
      {% for p in skbl.partners %}
        {% set tag = p.url ? 'a' : 'div' %}
        <{{ tag }}{% if p.url %} href="{{ p.url }}" target="_blank" rel="noopener"{% endif %} class="bg-card h-28 grid place-items-center p-5 {{ p.url ? 'hover:bg-surface' }}">
          {% if p.logo_url %}
            <img src="{{ p.logo_url }}" alt="{{ p.name }}" loading="lazy" class="max-h-16 max-w-full w-auto object-contain">
          {% else %}
            <span class="text-sm font-semibold text-muted text-center">{{ p.name }}</span>
          {% endif %}
        </{{ tag }}>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-muted">Partnery přidáte ve Struktura › Taxonomie › Partner.</p>
  {% endif %}
</section>
