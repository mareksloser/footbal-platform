{#
/**
 * @file
 * Stránka /kontakty (data ze skbl_core).
 * sections = skupiny vedení klubu (Vedení klubu, Výkonný výbor…), teams = trenéři.
 */
#}
<div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 space-y-14">
  {% for section in sections %}
    <section>
      <h2 class="cond text-4xl font-bold mb-6">{{ section.title }}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for c in section.items %}
          {{ include('skbl:contact-card', {
            heading: c.role, name: c.name, phone: c.phone, phone_href: c.phone_href, email: c.email, merged: false,
          }, with_context = false) }}
        {% endfor %}
      </div>
    </section>
  {% endfor %}

  {% if teams %}
    <section>
      <h2 class="cond text-4xl font-bold mb-6">Trenéři a vedoucí týmů</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for c in teams %}
          {{ include('skbl:contact-card', {
            heading: c.team, subheading: c.role, name: c.name, phone: c.phone, phone_href: c.phone_href, email: c.email, merged: c.merged,
          }, with_context = false) }}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if not sections and not teams %}
    <p class="text-muted">Kontakty zatím nejsou vyplněné. Doplňte realizační tým u nodu „Celý klub“ a u jednotlivých týmů.</p>
  {% endif %}
</div>
