{#
/**
 * @file
 * Výchozí blok. Zobrazený název bloku slouží jako nadpis sekce
 * (např. view „Poslední výsledky“ v Layout Builderu).
 */
#}
<div{{ attributes.addClass('skbl-block') }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes.addClass('skbl-block__title', 'cond', 'text-4xl', 'font-bold', 'mb-6') }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
