{#
/**
 * @file
 * Detail akce – termín, místo, popis, přidání do kalendáře, další akce a zápasy.
 * Data: skbl (karta) a event (detail) ze skbl_preprocess_node__event().
 */
#}
<article{{ attributes }}>
  {{ title_prefix }}{{ title_suffix }}

  {# --- Záhlaví --- #}
  <header class="bg-surface border-b border-line relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-red"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12">
      <nav aria-label="Drobečková navigace" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="{{ path('<front>') }}" class="hover:text-ink">Úvod</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a href="/kalendar" class="hover:text-ink">Kalendář</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">{{ label }}</span></li>
        </ol>
      </nav>

      <div class="mt-6 flex items-start gap-5 sm:gap-7">
        {% if event.date %}
          <div class="shrink-0 w-20 sm:w-24 bg-card border border-line rounded-xl overflow-hidden text-center">
            <div class="bg-red text-white text-xs font-semibold py-1">{{ event.date.month_short }}</div>
            <div class="py-2">
              <div class="cond text-4xl sm:text-5xl font-bold leading-none tnum">{{ event.date.day }}</div>
              <div class="text-xs text-muted mt-1">{{ event.date.weekday }}</div>
            </div>
          </div>
        {% endif %}
        <div class="min-w-0">
          {% if event.past %}<span class="inline-block mb-2 px-2.5 py-0.5 rounded-full bg-ink/10 text-sm font-semibold">Proběhlo</span>{% endif %}
          <h1 class="cond text-4xl sm:text-6xl font-bold leading-[.95] text-balance">{{ label }}</h1>
          <p class="mt-3 text-lg text-muted">
            {{ event.date.long|capitalize }}{% if event.range %} ({{ event.range }}){% endif %}{{ event.time ? ', ' ~ event.time : (event.all_day ? ', celý den') }}{% if event.location %} · {{ event.location }}{% endif %}
          </p>
          {% if event.teams %}
            <p class="mt-3 flex flex-wrap gap-2">
              {% for t in event.teams %}{{ include('skbl:team-chip', {label: t.label, merged: t.merged, club: t.club}, with_context = false) }}{% endfor %}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

  {# --- Obsah --- #}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid lg:grid-cols-[1fr_22rem] gap-12">
    <div class="min-w-0 space-y-12">
      {% if event.image %}
        <img src="{{ event.image }}" alt="" class="w-full aspect-[16/9] object-cover rounded-xl">
      {% endif %}

      {% if content.body|render|striptags|trim %}
        <div class="skbl-prose max-w-3xl">{{ content.body }}</div>
      {% elseif not event.past %}
        <p class="text-muted">Podrobnosti k akci doplníme. Sledujte kalendář nebo si akci přidejte do telefonu.</p>
      {% endif %}

      {% if event.matches %}
        <section>
          <h2 class="cond text-3xl font-bold mb-2">Nejbližší zápasy</h2>
          <div class="divide-y divide-line border-y border-line">
            {% for m in event.matches %}<div>{{ m }}</div>{% endfor %}
          </div>
        </section>
      {% endif %}
    </div>

    <aside class="space-y-6 lg:sticky lg:top-44 self-start">
      <div class="skbl-card">
        <h2 class="cond text-2xl font-bold mb-3">Kdy a kde</h2>
        <dl class="text-sm divide-y divide-line">
          <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Datum</dt><dd class="text-right font-semibold">{{ event.range ?: event.date.long|capitalize }}</dd></div>
          <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Čas</dt><dd class="text-right font-semibold tnum">{{ event.time ?: 'celý den' }}</dd></div>
          {% if event.location %}
            <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Místo</dt><dd class="text-right font-semibold">{{ event.location }}</dd></div>
          {% endif %}
        </dl>
        {% if event.map_url %}<a href="{{ event.map_url }}" target="_blank" rel="noopener" class="inline-block mt-3 text-sm font-semibold text-redink hover:underline">Zobrazit na Mapy.cz</a>{% endif %}
      </div>

      {% if not event.past and (event.ics_url or event.google_url) %}
        <div class="skbl-card">
          <h2 class="cond text-2xl font-bold mb-3">Přidat do kalendáře</h2>
          <div class="flex flex-wrap gap-2">
            {% if event.ics_url %}<a href="{{ event.ics_url }}" class="h-10 px-4 inline-flex items-center rounded-md bg-ink text-bg text-sm font-semibold hover:opacity-90">iPhone / Outlook</a>{% endif %}
            {% if event.google_url %}<a href="{{ event.google_url }}" target="_blank" rel="noopener" class="h-10 px-4 inline-flex items-center rounded-md border border-line text-sm font-semibold hover:bg-surface">Google Kalendář</a>{% endif %}
          </div>
        </div>
      {% endif %}

      {% if event.others %}
        <div class="skbl-card">
          <div class="flex items-baseline justify-between gap-3 mb-1">
            <h2 class="cond text-2xl font-bold">Další akce</h2>
            <a href="/kalendar" class="text-sm font-semibold text-redink hover:underline">Kalendář</a>
          </div>
          <div class="divide-y divide-line">
            {% for o in event.others %}<div>{{ o }}</div>{% endfor %}
          </div>
        </div>
      {% endif %}
    </aside>
  </div>
</article>
