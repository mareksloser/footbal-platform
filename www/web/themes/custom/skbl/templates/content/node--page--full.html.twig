{#
/**
 * @file
 * Základní stránka (O klubu, Nábor…).
 * Nadpis a perex (field_lead) tiskne šedé záhlaví stránky.
 * Hlavní sloupec: field_body + komponenty (field_page_c),
 * boční panel: field_page_sidebar (každá položka = karta).
 */
#}
{% set has_aside = content.field_page_sidebar|render|striptags('<img>')|trim is not empty %}
<article{{ attributes.addClass('mx-auto', 'max-w-7xl', 'px-4', 'sm:px-6', 'py-12', 'sm:py-14') }}>
  {{ title_prefix }}{{ title_suffix }}
  <div class="{{ has_aside ? 'grid lg:grid-cols-[1fr_22rem] gap-12 lg:gap-14' : 'max-w-4xl' }}">
    <div class="min-w-0 space-y-14">
      {% if content.field_body|render|trim %}
        <div class="skbl-prose max-w-3xl">{{ content.field_body }}</div>
      {% endif %}
      {{ content.field_page_c }}
    </div>
    {% if has_aside %}
      <aside class="skbl-aside space-y-6 lg:sticky lg:top-44 self-start">{{ content.field_page_sidebar }}</aside>
    {% endif %}
  </div>
</article>
