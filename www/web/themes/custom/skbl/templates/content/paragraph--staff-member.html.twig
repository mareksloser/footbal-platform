<div class="py-2.5">
  <div class="flex justify-between gap-3">
    <dt class="text-muted">{{ skbl.role }}</dt>
    <dd class="font-semibold text-right">{{ skbl.name }}</dd>
  </div>
  {% if skbl.phone or skbl.email %}
    <p class="mt-0.5 flex flex-wrap justify-end gap-x-3 text-xs">
      {% if skbl.phone %}<a href="tel:{{ skbl.phone_href }}" class="text-redink tnum hover:underline">{{ skbl.phone_display }}</a>{% endif %}
      {% if skbl.email %}<a href="mailto:{{ skbl.email }}" class="text-redink hover:underline">{{ skbl.email }}</a>{% endif %}
    </p>
  {% endif %}
</div>
