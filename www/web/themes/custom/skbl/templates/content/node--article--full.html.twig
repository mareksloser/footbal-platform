{#
/**
 * @file
 * Detail aktuality. Nadpis, perex, datum a tým tiskne šedé záhlaví stránky.
 */
#}
<article{{ attributes.addClass('mx-auto', 'max-w-7xl', 'px-4', 'sm:px-6', 'py-12') }}>
  {{ title_prefix }}{{ title_suffix }}

  {% if skbl.image_wide %}
    <figure class="max-w-5xl mb-10 -mx-4 sm:mx-0">
      <img src="{{ skbl.image_wide }}" alt="{{ skbl.image_alt }}" class="w-full aspect-[16/9] object-cover sm:rounded-xl">
    </figure>
  {% endif %}

  <div class="max-w-3xl">
    <div class="skbl-prose">{{ content.body }}{{ content.field_body }}</div>

    {% if skbl.match_url %}
      <a href="{{ skbl.match_url }}" class="mt-8 flex items-center justify-between gap-4 bg-surface border border-line rounded-xl px-5 py-4 hover:border-ink/40">
        <span><span class="block text-sm text-muted">Zápas</span><span class="font-semibold">{{ skbl.match_label }}</span></span>
        <span class="text-sm font-semibold text-redink whitespace-nowrap">Detail zápasu</span>
      </a>
    {% endif %}

    {% if content.field_tags|render|striptags|trim %}
      <div class="mt-8 text-sm text-muted">{{ content.field_tags }}</div>
    {% endif %}
  </div>

  {% if skbl.related %}
    <section class="mt-16 pt-12 border-t border-line">
      <h2 class="cond text-3xl font-bold mb-6">Další aktuality</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">{{ skbl.related }}</div>
    </section>
  {% endif %}
</article>
