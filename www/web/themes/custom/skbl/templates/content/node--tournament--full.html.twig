{#
/**
 * @file
 * Detail turnaje (externího) – umístění, naše zápasy po fázích, konečné pořadí,
 * report, fotky, přílohy, odkaz na výsledky pořadatele.
 * Data: skbl (karta) a tournament (detail) ze skbl_preprocess_node__tournament().
 */
#}
{% set badge = {
  'V': ['Výhra', 'bg-win text-white'],
  'P': ['Prohra', 'bg-red text-white'],
  'R': ['Remíza', 'bg-draw text-white'],
} %}
{% set t = tournament %}
<article{{ attributes }}>
  {{ title_prefix }}{{ title_suffix }}

  {# --- Záhlaví --- #}
  <header class="bg-surface border-b border-line relative overflow-hidden">
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 {{ skbl.team_merged ? 'bg-blue' : 'bg-red' }}"></div>
    <div aria-hidden="true" class="absolute inset-y-0 right-[12%] w-[14%] bg-card/70 border-x border-red/10 max-md:hidden"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-10 sm:py-12">
      <nav aria-label="Drobečková navigace" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="{{ path('<front>') }}" class="hover:text-ink">Úvod</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a href="/kalendar?typ=tournament" class="hover:text-ink">Turnaje</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span class="text-ink" aria-current="page">{{ label }}</span></li>
        </ol>
      </nav>

      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <div class="flex items-start gap-5 sm:gap-7 min-w-0">
          {% if t.date %}
            <div class="shrink-0 w-20 sm:w-24 bg-card border border-line rounded-xl overflow-hidden text-center">
              <div class="bg-red text-white text-xs font-semibold py-1">{{ t.date.month_short }}</div>
              <div class="py-2">
                <div class="cond text-4xl sm:text-5xl font-bold leading-none tnum">{{ t.date.day }}</div>
                <div class="text-xs text-muted mt-1">{{ t.date.weekday }}</div>
              </div>
            </div>
          {% endif %}
          <div class="min-w-0">
            <p class="text-sm text-muted font-semibold">Turnaj</p>
            <h1 class="cond text-4xl sm:text-6xl font-bold leading-[.95] text-balance">{{ label }}</h1>
            <p class="mt-3 text-lg text-muted">
              {{ t.date.long|capitalize }}{% if t.range %} ({{ t.range }}){% endif %}{{ t.time ? ', ' ~ t.time }}{% if t.venue %} · {{ t.venue }}{% endif %}
            </p>
            {% if t.teams %}
              <p class="mt-3 flex flex-wrap gap-2">
                {% for team in t.teams %}{{ include('skbl:team-chip', {label: team.label, merged: team.merged, club: team.club}, with_context = false) }}{% endfor %}
              </p>
            {% endif %}
          </div>
        </div>

        {% if t.placement %}
          <div class="bg-card border border-line rounded-xl px-6 py-4 text-center">
            <p class="text-xs text-muted">Umístění</p>
            <p class="cond text-4xl font-bold text-redink leading-tight">{{ t.placement }}</p>
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  {# --- Obsah --- #}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 grid lg:grid-cols-[1fr_22rem] gap-12">
    <div class="min-w-0 space-y-12">

      {% if t.phases %}
        <section>
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
            <h2 class="cond text-3xl font-bold">Naše zápasy</h2>
            {% if t.record %}
              <p class="text-sm text-muted tnum">
                <span class="font-semibold text-win">{{ t.record.V }} V</span> ·
                <span class="font-semibold text-draw">{{ t.record.R }} R</span> ·
                <span class="font-semibold text-redink">{{ t.record.P }} P</span> ·
                skóre {{ t.record.gf }}:{{ t.record.ga }}
              </p>
            {% endif %}
          </div>
          <div class="space-y-8">
            {% for phase in t.phases %}
              <div>
                {% if phase.label %}<h3 class="font-semibold text-muted mb-2">{{ phase.label }}</h3>{% endif %}
                <ul class="bg-card border border-line rounded-xl divide-y divide-line">
                  {% for g in phase.games %}
                    <li class="flex items-center gap-4 px-4 py-3">
                      <div class="flex-1 min-w-0">
                        <p class="truncate"><span class="font-semibold">{{ skbl.team_label|default('Libušín') }}</span> <span class="text-muted">–</span> {{ g.opponent }}</p>
                        {% if g.scorers %}<p class="text-xs text-muted mt-0.5 truncate">Góly: {{ g.scorers }}</p>{% endif %}
                      </div>
                      <div class="text-right">
                        <p class="cond text-2xl font-bold tnum leading-none">{% if g.us is not null %}{{ g.us }}:{{ g.them }}{% else %}–{% endif %}</p>
                        {% if g.penalties %}<p class="text-xs text-muted mt-0.5">{{ g.penalties }}</p>{% endif %}
                      </div>
                      {% if g.result %}
                        {% set b = badge[g.result] %}
                        <span class="h-7 w-7 grid place-items-center rounded text-xs font-bold {{ b[1] }}" title="{{ b[0] }}">{{ g.result }}</span>
                      {% else %}
                        <span class="w-7"></span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      {% if content.field_standings|render|striptags|trim %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">Konečné pořadí</h2>
          <div class="skbl-standings" data-skbl-highlight="Libušín">{{ content.field_standings }}</div>
        </section>
      {% endif %}

      {% if content.body|render|striptags|trim %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">{{ t.past ? 'Jak jsme hráli' : 'O turnaji' }}</h2>
          <div class="skbl-prose max-w-3xl">{{ content.body }}</div>
        </section>
      {% elseif not t.past and not t.phases %}
        <p class="text-muted">Podrobnosti a výsledky doplníme po turnaji.</p>
      {% endif %}

      {% if t.images %}
        <section>
          <h2 class="cond text-3xl font-bold mb-5">Fotky</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {% for img in t.images %}
              <a href="{{ img.full }}" target="_blank" rel="noopener" class="block aspect-[16/10] rounded-lg overflow-hidden bg-surface">
                <img src="{{ img.thumb }}" alt="{{ img.alt }}" loading="lazy" class="h-full w-full object-cover hover:scale-[1.03] transition-transform">
              </a>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>

    <aside class="space-y-6 lg:sticky lg:top-44 self-start">
      <div class="skbl-card">
        <h2 class="cond text-2xl font-bold mb-3">O turnaji</h2>
        <dl class="text-sm divide-y divide-line">
          <div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Datum</dt><dd class="text-right font-semibold">{{ t.range ?: t.date.long|capitalize }}</dd></div>
          {% if t.time %}<div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Začátek</dt><dd class="text-right font-semibold tnum">{{ t.time }}</dd></div>{% endif %}
          {% if t.venue %}<div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Místo</dt><dd class="text-right font-semibold">{{ t.venue }}</dd></div>{% endif %}
          {% if t.organizer %}<div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Pořadatel</dt><dd class="text-right font-semibold">{{ t.organizer }}</dd></div>{% endif %}
          {% if t.format %}<div class="py-2.5 flex justify-between gap-4"><dt class="text-muted">Formát</dt><dd class="text-right font-semibold">{{ t.format }}</dd></div>{% endif %}
        </dl>
        {% if t.link %}
          <a href="{{ t.link.url }}" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-redink hover:underline">
            {{ t.link.title }}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
          </a>
        {% endif %}
      </div>

      {% if t.calendar %}
        <div class="skbl-card">
          <h2 class="cond text-2xl font-bold mb-3">Přidat do kalendáře</h2>
          <div class="flex flex-wrap gap-2">
            {% if t.calendar.ics %}<a href="{{ t.calendar.ics }}" class="h-10 px-4 inline-flex items-center rounded-md bg-ink text-bg text-sm font-semibold hover:opacity-90">iPhone / Outlook</a>{% endif %}
            <a href="{{ t.calendar.google }}" target="_blank" rel="noopener" class="h-10 px-4 inline-flex items-center rounded-md border border-line text-sm font-semibold hover:bg-surface">Google Kalendář</a>
          </div>
        </div>
      {% endif %}

      {% if t.attachments %}
        <div class="skbl-card">
          <h2 class="cond text-2xl font-bold mb-2">Ke stažení</h2>
          <ul class="divide-y divide-line text-sm">
            {% for a in t.attachments %}
              <li class="py-2.5 flex justify-between gap-3">
                <a href="{{ a.url }}" class="font-semibold text-redink hover:underline min-w-0 truncate">{{ a.name }}</a>
                <span class="text-muted shrink-0">{{ a.size }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </aside>
  </div>
</article>
