<div{{ attributes }}>
  {{ title_prefix }}{{ title_suffix }}
  {{ include('skbl:event-item', {
    url: url,
    title: label,
    day: skbl.date.day,
    month: skbl.date.month_short,
    note: skbl.note,
    team_label: skbl.team_label,
    team_merged: skbl.team_merged,
    team_is_club: skbl.team_is_club,
    show_team: skbl.show_team,
  }, with_context = false) }}
</div>
