{% if breadcrumb %}
  <nav aria-label="Drobečková navigace" class="text-sm text-muted">
    <ol class="flex flex-wrap items-center gap-2">
      {% for item in breadcrumb %}
        <li class="flex items-center gap-2">
          {% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}
          {% if item.url %}
            <a href="{{ item.url }}" class="hover:text-ink">{{ item.text }}</a>
          {% else %}
            <span class="text-ink" aria-current="page">{{ item.text }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
