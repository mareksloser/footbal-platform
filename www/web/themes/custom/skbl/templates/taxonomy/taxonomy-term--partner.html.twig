{#
/**
 * @file
 * Partner na stránce /partneri – logo, název, popis a odkaz na web.
 */
#}
{% set main = skbl.level == 'main' %}
<article{{ attributes.addClass('h-full', 'flex', 'flex-col', 'bg-card', 'border', 'border-line', 'rounded-xl', 'overflow-hidden') }}>
  {{ title_prefix }}{{ title_suffix }}
  <div class="grid place-items-center bg-surface border-b border-line {{ main ? 'h-48 p-8' : 'h-36 p-6' }}">
    {% if skbl.logo_url %}
      <img src="{{ skbl.logo_url }}" alt="{{ skbl.name }}" loading="lazy" class="{{ main ? 'max-h-28' : 'max-h-20' }} max-w-full w-auto object-contain">
    {% else %}
      <span class="cond text-3xl font-bold text-muted text-center">{{ skbl.name }}</span>
    {% endif %}
  </div>
  <div class="p-5 flex flex-col flex-1">
    <h3 class="cond {{ main ? 'text-3xl' : 'text-2xl' }} font-bold leading-tight">{{ skbl.name }}</h3>
    {% if content.description|render|striptags|trim %}
      <div class="mt-2 text-muted text-sm leading-relaxed [&_p+p]:mt-2">{{ content.description }}</div>
    {% endif %}
    {% if skbl.url %}
      <a href="{{ skbl.url }}" target="_blank" rel="noopener" class="mt-auto pt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-redink hover:underline">
        {{ skbl.host }}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    {% endif %}
  </div>
</article>
