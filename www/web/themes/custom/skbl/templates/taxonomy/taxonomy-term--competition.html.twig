{#
/**
 * @file
 * Stránka soutěže (Zimní liga…): tabulka, rozpis, výsledky, odkazy.
 * Nadpis tiskne šedé záhlaví stránky.
 */
#}
<div{{ attributes.addClass('mx-auto', 'max-w-7xl', 'px-4', 'sm:px-6', 'py-12', 'grid', 'lg:grid-cols-[1fr_22rem]', 'gap-12') }}>
  {{ title_prefix }}{{ title_suffix }}
  <div class="min-w-0 space-y-14">
    {% if content.field_standings|render|striptags|trim %}
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
          <h2 class="cond text-3xl font-bold">Tabulka</h2>
          {% if skbl.updated %}<p class="text-sm text-muted">Stav k {{ skbl.updated }}</p>{% endif %}
        </div>
        <div class="skbl-standings" data-skbl-highlight="Libušín">{{ content.field_standings }}</div>
      </section>
    {% endif %}

    {% if skbl.upcoming %}
      <section>
        <h2 class="cond text-3xl font-bold mb-2">Rozpis</h2>
        <div class="divide-y divide-line border-y border-line max-w-4xl">
          {% for m in skbl.upcoming %}<div>{{ m }}</div>{% endfor %}
        </div>
      </section>
    {% endif %}

    {% if skbl.played %}
      <section>
        <h2 class="cond text-3xl font-bold mb-2">Výsledky</h2>
        <div class="divide-y divide-line border-y border-line max-w-4xl">
          {% for m in skbl.played %}<div>{{ m }}</div>{% endfor %}
        </div>
      </section>
    {% endif %}
  </div>

  <aside class="space-y-6 lg:sticky lg:top-44 self-start">
    {% if content.description|render|striptags|trim %}
      <div class="skbl-card text-sm leading-relaxed [&_p+p]:mt-2">{{ content.description }}</div>
    {% endif %}
    {% if skbl.link %}
      <a href="{{ skbl.link.url }}" target="_blank" rel="noopener" class="skbl-card flex items-center justify-between gap-3 hover:border-ink/30">
        <span class="font-semibold">{{ skbl.link.title }}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-redink" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    {% endif %}
    {% if skbl.attachments %}
      <div class="skbl-card">
        <h2 class="cond text-2xl font-bold mb-2">Ke stažení</h2>
        <ul class="divide-y divide-line text-sm">
          {% for a in skbl.attachments %}
            <li class="py-2.5 flex justify-between gap-3">
              <a href="{{ a.url }}" class="font-semibold text-redink hover:underline min-w-0 truncate">{{ a.name }}</a>
              <span class="text-muted shrink-0">{{ a.size }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </aside>
</div>
