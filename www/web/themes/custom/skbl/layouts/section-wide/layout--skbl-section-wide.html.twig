{#
  Obsah bez bočních okrajů – pro posuvné pásy (soupiska).
  Nadpisy bloků se odsazují samy přes třídu .skbl-wide v CSS.
#}
{% if content %}
  <section{{ attributes.addClass('skbl-wide', 'mx-auto', 'max-w-7xl', 'py-12', 'sm:py-16') }}>
    <div{{ region_attributes.main.addClass('space-y-12') }}>{{ content.main }}</div>
  </section>
{% endif %}
