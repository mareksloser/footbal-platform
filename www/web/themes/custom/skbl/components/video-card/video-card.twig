{% set vertical = featured or stacked %}
<a href="{{ url|default('#') }}" class="group {{ vertical ? 'block' : 'grid grid-cols-[9rem_1fr] gap-4 items-start' }}"{% if external %} target="_blank" rel="noopener"{% endif %}>
  <div class="relative aspect-video rounded-lg overflow-hidden bg-gradient-to-br from-[#1d3b2a] to-[#0f2418]">
    {% if thumbnail_url %}
      <img src="{{ thumbnail_url }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover">
    {% else %}
      <svg viewBox="0 0 160 90" class="absolute inset-0 w-full h-full opacity-25" fill="none" stroke="white" stroke-width=".6" aria-hidden="true"><rect x="8" y="8" width="144" height="74"/><line x1="80" y1="8" x2="80" y2="82"/><circle cx="80" cy="45" r="12"/><rect x="8" y="28" width="18" height="34"/><rect x="134" y="28" width="18" height="34"/></svg>
    {% endif %}
    <span class="absolute inset-0 grid place-items-center">
      <span class="{{ featured ? 'h-16 w-16' : (stacked ? 'h-12 w-12' : 'h-9 w-9') }} rounded-full bg-white/95 grid place-items-center shadow-lg">
        <svg width="{{ featured ? 22 : (stacked ? 16 : 12) }}" height="{{ featured ? 22 : (stacked ? 16 : 12) }}" viewBox="0 0 24 24" class="text-red ml-0.5" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"/></svg>
      </span>
    </span>
    {% if external and source_label %}
      <span class="absolute left-2 top-2 inline-flex items-center gap-1 text-xs font-semibold bg-black/70 text-white px-1.5 py-0.5 rounded">
        {{ source_label }}
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </span>
    {% endif %}
    {% if duration %}<span class="absolute right-2 bottom-2 text-xs font-semibold tnum bg-black/70 text-white px-1.5 py-0.5 rounded">{{ duration }}</span>{% endif %}
  </div>
  <div class="min-w-0 {{ featured ? 'mt-4' : (stacked ? 'mt-3' : '') }}">
    <p class="text-sm text-muted flex flex-wrap items-center gap-2">
      {% if show_team %}{{ include('skbl:team-chip', {label: team_label, merged: team_merged}, with_context = false) }}{% endif %}
      <span>{{ category }}{{ category and date ? ', ' }}{{ date }}</span>
    </p>
    {% if featured %}
      <h3 class="cond text-3xl font-bold mt-1 group-hover:text-redink">{{ title }}{% if external %}<span class="sr-only"> (otevře se na {{ source_label|default('jiném webu') }})</span>{% endif %}</h3>
    {% elseif stacked %}
      <h3 class="font-semibold text-lg leading-snug mt-1 group-hover:text-redink">{{ title }}{% if external %}<span class="sr-only"> (otevře se na {{ source_label|default('jiném webu') }})</span>{% endif %}</h3>
    {% else %}
      <p class="font-semibold leading-snug group-hover:text-redink">{{ title }}{% if external %}<span class="sr-only"> (otevře se na {{ source_label|default('jiném webu') }})</span>{% endif %}</p>
    {% endif %}
  </div>
</a>
