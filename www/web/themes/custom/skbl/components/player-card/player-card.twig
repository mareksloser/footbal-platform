{% set tag = url ? 'a' : 'div' %}
<{{ tag }}{% if url %} href="{{ url }}"{% endif %} class="group block">
  <div class="shield relative aspect-[4/5] {{ partner ? 'bg-blue' : 'bg-red' }}">
    <div class="shield absolute {{ big ? 'inset-[8px]' : 'inset-[5px]' }} bg-surface overflow-hidden">
      {% if photo_url %}
        <img src="{{ photo_url }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-top">
      {% else %}
        <div aria-hidden="true" class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-[34%] bg-card"></div>
        <svg viewBox="0 0 120 150" class="absolute inset-x-0 bottom-0 w-full h-[82%] text-ink/15" aria-hidden="true"><circle cx="60" cy="52" r="24" fill="currentColor"/><path d="M12 150c2-34 22-56 48-56s46 22 48 56z" fill="currentColor"/></svg>
      {% endif %}
      {% if number is not empty %}
        <span class="absolute left-0 top-0 {{ photo_url ? 'bg-card/90 rounded-br-xl px-2.5 pt-1' : 'left-3 top-2' }} cond {{ big ? 'text-7xl' : 'text-5xl' }} font-extrabold tnum leading-none {{ partner ? 'text-blueink' : 'text-redink' }}">{{ number }}</span>
      {% endif %}
    </div>
  </div>
  {% if not bare %}
  <div class="mt-3 text-center">
    {% if first_name %}<p class="text-sm text-muted leading-tight">{{ first_name }}</p>{% endif %}
    <p class="cond text-xl font-bold leading-tight group-hover:text-redink">{{ last_name }}</p>
    {% if position or partner %}
      <p class="text-xs text-muted mt-1">
        {{ position }}{% if position and partner %} · {% endif %}{% if partner %}<span class="text-blueink font-semibold">{{ partner_label|default('Partnerský klub') }}</span>{% endif %}
      </p>
    {% endif %}
  </div>
  {% endif %}
</{{ tag }}>
