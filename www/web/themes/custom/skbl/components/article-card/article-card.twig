<article class="group relative h-full {{ featured ? 'grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:gap-10 lg:items-center' : 'flex flex-col' }}">
  <div class="relative aspect-[16/10] rounded-xl overflow-hidden bg-surface">
    {% if image_url %}
      <img src="{{ image_url }}" alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]">
    {% elseif logo_url %}
      <div class="absolute inset-0 grid place-items-center">
        <img src="{{ logo_url }}" alt="" class="h-16 w-auto opacity-20 grayscale">
      </div>
    {% endif %}
  </div>
  <div class="min-w-0 {{ featured ? '' : 'mt-4' }}">
    <p class="text-sm text-muted flex flex-wrap items-center gap-2">
      {% if show_team %}{{ include('skbl:team-chip', {label: team_label, merged: team_merged, club: team_is_club}, with_context = false) }}{% endif %}
      {% if date %}<span>{{ date }}</span>{% endif %}
    </p>
    <h3 class="cond {{ featured ? 'text-4xl sm:text-5xl' : 'text-2xl' }} font-bold leading-tight mt-1 text-balance">
      <a href="{{ url }}" class="group-hover:text-redink after:absolute after:inset-0">{{ title }}</a>
    </h3>
    {% if lead %}
      <p class="text-muted mt-2 {{ featured ? 'text-lg line-clamp-4' : 'line-clamp-3' }}">{{ lead }}</p>
    {% endif %}
  </div>
</article>
