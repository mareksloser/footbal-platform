APP_ENV=dev
APP_SECRET=zmen-me-na-nahodny-retezec

DATABASE_URL="mysql://auth:auth@127.0.0.1:3306/klub_auth?serverVersion=8.4&charset=utf8mb4"

# Veřejná adresa IdP – bez lomítka na konci. Musí přesně sedět s tím, co klienti používají jako "authority".
OIDC_ISSUER=https://auth.klub.test

OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/jwt/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
OAUTH_PASSPHRASE=
# openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

# Regex povolených originů SPA aplikací (CORS pro /oauth/token, /userinfo, /.well-known)
CORS_ALLOW_ORIGIN='^https://(mvr|videoteka|taktika)\.klub\.test$'
